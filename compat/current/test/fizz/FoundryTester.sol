import {Test} from "forge-std/Test.sol";
import {console} from "forge-std/console.sol";
import {Handlers} from "./handlers/Handlers.sol";

/// @notice Contract to be used for quick testing with Foundry
contract FoundryTester is Test, Handlers {
    modifier asActor() override {
        vm.startPrank(actor);
        _;
        vm.stopPrank();
    }

    function setUp() public {
        // Medusa/Echidna fund FuzzTester via config; Foundry needs it explicitly.
        vm.deal(address(this), type(uint128).max);
        setup();
    }

    // forge test --match-test test_sequence -vvv
    function test_sequence() public {
        // Add here call sequence to Handler's functions to reproduce failing property
    }

    /// @dev Smoke check that every handler path reaches its protocol call without reverting.
    function test_handlerPaths() public {
        router_swap_clamped(true, 1 ether, 3_000e6, 0); // sell above spot: rests
        assertEq(orders.length, 1);
        assertEq(liveAmountIn(orders[0]), 1 ether, "sell rests");
        setCurrentActor(1);
        router_swap_clamped(false, 1 ether, 1_500e6, 0); // buy below spot: rests
        assertEq(liveAmountIn(orders[1]), 1_500e6, "buy rests");
        asyncSwap_updatePrice_clamped(0, 2_500e6);
        router_matchBook_clamped(8);
        setCurrentActor(2);
        router_fillOrder_clamped(0, true); // fill the sell with USDC
        assertEq(liveAmountIn(orders[0]), 0, "sell filled");
        router_fillOrder_clamped(1, false); // fill the buy with ETH
        assertEq(liveAmountIn(orders[1]), 0, "buy filled");
        setCurrentActor(0);
        router_swap_clamped(true, 1 ether, 3_500e6, 0);
        router_swap_clamped(true, 2 ether, 3_600e6, 0);
        router_cancelOrder_clamped(2);
        router_multicallCancel_clamped(3, 5);
        router_swap_clamped(false, 1 ether, 1_200e6, 0);
        router_multicallCancel_clamped(5, 5);
        router_swap_clamped(true, 1 ether, 1_000e6, 0); // sell below spot: LP fill on submit
        setCurrentActor(1);
        nativeClaims_redeem_clamped(1, true);
        tokenClaims_redeem_clamped(1, true);
        router_swap_clamped(true, 1 ether, 3_000e6, 0);
        router_fillFromPoolLiquidity_clamped(orders.length - 1); // above spot: no fill, no revert
        feeVault_secondary(false);
        asyncSwap_secondary(2, 1e6, false);
        asyncSwap_donateETH(1 ether, false);
        asyncSwap_secondary(1, 0, true);
    }

    // ── Violation Repros (auto-generated by Step 11) ──────────────────
    // Each test_repro_* function below replays a shrunk fuzzer call
    // sequence that violated a property. Run all with:
    //   forge test --match-contract FoundryTester -vvv
}
