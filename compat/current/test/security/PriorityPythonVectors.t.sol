    function _check(uint256 a, uint256 q, uint256 Q, uint256 A, bool rb, bool cross, uint256 asset, uint256 quote)
        internal
    {
        uint256 checkpoint = vm.snapshotState();
        Case memory c;
        c.k = key;
        c.pid = poolId;
        c.a = a;
        c.q = q;
        c.Q = Q;
        c.A = A;
        c.restingBuy = rb;
        c.pf = true;
        c.sellBid = q / 1000 < 100000 ? q / 1000 : 100000;
        c.buyBid = Q / 1000 < 100000 ? Q / 1000 : 100000;
        if (rb) {
            c.buyId = _rest(c.k, bob, false, Q, A, c.buyBid);
            c.sellId = _rest(c.k, alice, true, a, q, c.sellBid);
        } else {
            c.sellId = _rest(c.k, alice, true, a, q, c.sellBid);
            c.buyId = _rest(c.k, bob, false, Q, A, c.buyBid);
        }
        Run memory result = _exec(c);
        assertEq(result.crosses, cross, "Python cross predicate");
        bool trades = cross && asset > 0 && quote > 0;
        assertEq(result.matched, trades ? 1 : 0, "Python match existence");
        if (trades) {
            Op memory last = _matchedOp(result.ops);
            assertEq(last.kind, OP_MATCHED);
            assertEq(last.amount, asset, "Python asset amount");
            assertEq(last.amount2, quote, "Python quote amount");
            _assertReductions(c, result);
        }
        assertTrue(vm.revertToState(checkpoint));
    }

