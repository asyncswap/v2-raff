// Current port: target contracts@3f4a5f1. Acceptance profile: current.
/// @title AsyncSwap
/// @notice Uniswap v4 hook that converts an exact-input swap into an open async order: the maker deposits
///         their input in `beforeSwap`. Crossing orders settle directly at the resting limit; fillers settle
///         unmatched orders; a resting order is tried against the pool's LPs.
/// @dev Huff build of `asyncswap/contracts` `src/AsyncSwap.sol` with `BaseHook`, `AsyncFiller`, `AsyncMatching`
///      (inlined here instead of a linked library), `RadixPriceTree`, `OrderSignatures` and OpenZeppelin's
///      `EIP712` / `SignatureChecker`. Same ABI, events, errors and behaviour.
///
///      Constructor arguments (ABI-encoded after the creation code): `(IPoolManager poolManager, Currency
///      numeraire, address owner, address router, uint256 minOrderUsd, uint8 assetPrecision)`. The hook must sit at an address whose low 14 bits are exactly
///      BEFORE_INITIALIZE | BEFORE_ADD_LIQUIDITY | BEFORE_SWAP | BEFORE_SWAP_RETURNS_DELTA (`0x2888`). The
///      constructor deploys the FeeVault, as the Solidity's `new FeeVault(poolManager)`.
///
///      Test-only builds: `-c POOL_FEE_MODE=1` (`calculatePoolFee = amount / 100`, the FeeClaims tests) and
///      `-c SKIP_HOOK_ADDRESS_CHECK=1` (the constructor tests).

#include "../lib/Common.huff"
#include "../lib/Math.huff"
#include "../lib/RadixPriceTree.huff"
#include "./lib/TickPrice.huff"
#include "./lib/TickBitmap.huff"
#include "./lib/Book.huff"
#include "./lib/ExactPrice.huff"
#include "./lib/MatchAmounts.huff"
#include "./lib/Liquidity.huff"
#include "./lib/Incoming.huff"
#include "./lib/ClaimTransfers.huff"
#include "../lib/PoolManager.huff"
#include "../lib/Signatures.huff"
#include "../generated/FeeVaultCreation.huff"

