// SPDX-License-Identifier: MIT
// Packed names keep their byte length in the low byte, matching OpenZeppelin ShortStrings.
#define fn SHORT_STRING_LENGTH() = takes (1) returns (1) {
    0xff and dup1 0x1f lt iszero valid jumpi
    __FUNC_SIG("InvalidShortString()") 0xe0 shl REVERT_0()
    valid:
}
#define macro RETURN_SHORT_STRING() = takes (1) returns (0) {
    dup1 SHORT_STRING_LENGTH() 0x20 mstore
    0xff not and 0x40 mstore 0x20 0x00 mstore 0x60 0x00 return
}
#define macro RETURN_STORAGE_STRING() = takes (1) returns (0) {
    // Solidity's string layout: short bytes live in the slot; long bytes start at keccak(slot).
    dup1 sload dup1 0x01 and long jumpi
    swap1 pop dup1 0xff and 0x01 shr 0x20 mstore
    0xff not and 0x40 mstore 0x20 0x00 mstore 0x60 0x00 return
    long:
    0x01 shr 0x20 mstore
    0x00 mstore 0x20 0x00 sha3 0x00
    loop:
    0x20 mload dup2 lt iszero done jumpi
    dup1 0x05 shr dup3 add sload dup2 0x40 add mstore
    0x20 add loop jump
    done: swap1 pop 0x40 add 0x20 0x00 mstore 0x00 return
}
