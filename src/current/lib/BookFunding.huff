// Funding and order creation call the same indexing routines as direct book mutations.
/// @notice `AsyncFiller.addOrder`. Inputs: B_P, B_ID, B_OWNER, B_IN, B_MIN, B_BUY, B_ZFO, B_FEE.
#define fn BOOK_ADD() = takes (0) returns (0) {
    BOOK_CHECK_MINIMUM()
    [UINT64_MASK] [B_FEE] mload gt iszero fee_fits jumpi
    __FUNC_SIG("PriorityFeeTooLarge()") 0xe0 shl REVERT_0()
    fee_fits:
    [B_FEE] mload iszero fee_checked jumpi
    [B_MIN] mload [B_BUY] mload iszero sell jumpi
    pop [B_IN] mload
    sell: MINIMUM_BID() [B_FEE] mload lt iszero fund jumpi
    __FUNC_SIG("PriorityFeeTooSmall()") 0xe0 shl REVERT_0()
    fund: [B_FEE] mload NUMERAIRE() address F_MINT()
    fee_checked:
    [B_MIN] mload [B_IN] mload [B_ZFO] mload [B_BUY] mload CURRENT_PRICE_KEY()
    NEXT_SEQUENCE()
    ORDER_TO_B()
    dup1 [B_O] mload 0x06 add O_STORE()
    dup1 [B_O] mload 0x04 add O_STORE()
    [B_FEE] mload PRIORITY_KEY_OF() 0x80 shl or [B_O] mload 0x01 add O_STORE()
    [B_FEE] mload 0xb8 shl 0x01 0xb0 shl or
    [B_ZFO] mload 0xa8 shl or [B_BUY] mload 0xa0 shl or [B_OWNER] mload or [B_O] mload O_STORE()
    [B_IN] mload [B_O] mload 0x02 add O_STORE()
    [B_MIN] mload [B_O] mload 0x03 add O_STORE()
    BOOK_APPEND()
}
