/// @title MatchingEngine
/// @notice Standalone price-time matching harness: a radix-indexed limit book that emits deterministic fill
///         instructions. Algorithm and gas benchmark only; it does not custody or settle tokens.
/// @dev Huff build of `asyncswap/contracts` `src/MatchingEngine.sol`, on the same `RadixPriceTree` as the hook.
///      The Solidity's reentrancy guard is a transient flag here: the engine makes no external calls, and the
///      flag is set and cleared within each call either way.
///
///      Book of `market`: M = keccak(market, 0):
///        M + 0   nextOrderId (0–63) | nextSequence (64–127)
///        M + 1   bid tree      M + 2   ask tree
///        M + 3   bid levels: keccak(price, M + 3)      M + 4   ask levels: keccak(price, M + 4)
///        M + 5   orders: keccak(orderId, M + 5) → 3 slots
///      Level: head (0–63) | tail (64–127) | orderCount (128–159).
///      Order: O + 0 owner | isBuy (160) | active (168) | sequence (176–239); O + 1 price | remaining << 128;
///             O + 2 previous | next << 64.

#include "./lib/Common.huff"
#include "./lib/Math.huff"
#include "./lib/RadixPriceTree.huff"

