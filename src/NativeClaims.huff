//'####:'##::: ##:'########:'########:'########::'########::::'###:::::'######::'########:
//. ##:: ###:: ##:... ##..:: ##.....:: ##.... ##: ##.....::::'## ##:::'##... ##: ##.....::
//: ##:: ####: ##:::: ##:::: ##::::::: ##:::: ##: ##::::::::'##:. ##:: ##:::..:: ##:::::::
//: ##:: ## ## ##:::: ##:::: ######::: ########:: ######:::'##:::. ##: ##::::::: ######:::
//: ##:: ##. ####:::: ##:::: ##...:::: ##.. ##::: ##...:::: #########: ##::::::: ##...::::
//: ##:: ##:. ###:::: ##:::: ##::::::: ##::. ##:: ##::::::: ##.... ##: ##::: ##: ##:::::::
//'####: ##::. ##:::: ##:::: ########: ##:::. ##: ##::::::: ##:::: ##:. ######:: ########:
//....::..::::..:::::..:::::........::..:::::..::..::::::::..:::::..:::......:::........::
//
#define error OnlyPoolManager()
#define error InvalidRedemption()
#define error ReentrantRedemption()

#define event NativeRedeemed(address indexed, address indexed, uint256)

//:'######::'########::'#######::'########:::::'###:::::'######:::'########:
//'##... ##:... ##..::'##.... ##: ##.... ##:::'## ##:::'##... ##:: ##.....::
// ##:::..::::: ##:::: ##:::: ##: ##:::: ##::'##:. ##:: ##:::..::: ##:::::::
//. ######::::: ##:::: ##:::: ##: ########::'##:::. ##: ##::'####: ######:::
//:..... ##:::: ##:::: ##:::: ##: ##.. ##::: #########: ##::: ##:: ##...::::
//'##::: ##:::: ##:::: ##:::: ##: ##::. ##:: ##.... ##: ##::: ##:: ##:::::::
//. ######::::: ##::::. #######:: ##:::. ##: ##:::: ##:. ######::: ########:
//:......::::::..::::::.......:::..:::::..::..:::::..:::......::::........::
//
#define constant REDEEMING_SLOT = 0x00
#define constant IMMUTABLES = __codesize(RUNTIME)

#define macro MANAGER() = takes (0) returns (1) { 0x40 mload }

//'########:'##::: ##:'########:'########::'##:::'##:
// ##.....:: ###:: ##:... ##..:: ##.... ##:. ##:'##::
// ##::::::: ####: ##:::: ##:::: ##:::: ##::. ####:::
// ######::: ## ## ##:::: ##:::: ########::::. ##::::
// ##...:::: ##. ####:::: ##:::: ##.. ##:::::: ##::::
// ##::::::: ##:. ###:::: ##:::: ##::. ##::::: ##::::
// ########: ##::. ##:::: ##:::: ##:::. ##:::: ##::::
//........::..::::..:::::..:::::..:::::..:::::..:::::
//
#define macro CONSTRUCTOR() = takes (0) returns (0) {
    [IMMUTABLES] __codesize(CONSTRUCTOR) 0x100 codecopy
    0x20 0x20 codesize sub [IMMUTABLES] 0x100 add codecopy
    [IMMUTABLES] 0x20 add 0x100 return
}

//'########::'##::::'##:'########::'##:::::::'####::'######::
// ##.... ##: ##:::: ##: ##.... ##: ##:::::::. ##::'##... ##:
// ##:::: ##: ##:::: ##: ##:::: ##: ##:::::::: ##:: ##:::..::
// ########:: ##:::: ##: ########:: ##:::::::: ##:: ##:::::::
// ##.....::: ##:::: ##: ##.... ##: ##:::::::: ##:: ##:::::::
// ##:::::::: ##:::: ##: ##:::: ##: ##:::::::: ##:: ##::: ##:
// ##::::::::. #######:: ########:: ########:'####:. ######::
//..::::::::::.......:::........:::........::....:::......:::
/// @notice `redeem(recipient, amount)`.
#define macro REDEEM() = takes (0) returns (0) {
    [REDEEMING_SLOT] tload iszero entered jumpi
    __ERROR(ReentrantRedemption) REVERT_0()
    entered:
    0x01 [REDEEMING_SLOT] tstore
    LOAD_ADDRESS(0x04) dup1 iszero bad_redemption jumpi
    0x24 calldataload dup1 iszero bad_redemption jumpi
    [CALL_84] mstore [CALL_64] mstore
    caller [CALL_44] mstore
    0x60 PM_UNLOCK()
    0x00 [REDEEMING_SLOT] tstore
    RETURN_EMPTY()
    bad_redemption:
    __ERROR(InvalidRedemption) REVERT_0()
}

#define constant DATA = 0x100
#define constant DATA_LENGTH = 0x120
/// @dev Decode the dynamic bytes argument, including noncanonical but valid ABI offsets.
///      Bound offsets and lengths before addition so malformed input cannot wrap into the head.
#define macro DECODE_CALLBACK() = takes (0) returns (0) {
    0x24 calldatasize lt bad jumpi
    0x04 calldataload dup1 0x40 shr bad jumpi
    0x04 add dup1 0x20 add calldatasize lt bad jumpi
    dup1 calldataload dup1 0x40 shr bad jumpi
    dup2 0x20 add add calldatasize lt bad jumpi
    dup1 calldataload [DATA_LENGTH] mstore
    0x20 add [DATA] mstore
    done jump
    bad: 0x00 0x00 revert
    done:
}

#define macro UNLOCK_CALLBACK() = takes (0) returns (0) {
    DECODE_CALLBACK()
    MANAGER() caller eq from_manager jumpi
    __ERROR(OnlyPoolManager) REVERT_0()
    from_manager:
    [DATA_LENGTH] mload 0x60 gt bad_inner jumpi
    [DATA] mload calldataload 0xa0 shr bad_inner jumpi
    [DATA] mload 0x20 add calldataload 0xa0 shr bad_inner jumpi
    // Burn first. A failed transfer atomically restores both claims and allowance.
    [DATA] mload 0x40 add calldataload 0x00 [DATA] mload calldataload PM_BURN()         // burn(owner, 0, amount)
    [DATA] mload 0x40 add calldataload [DATA] mload 0x20 add calldataload 0x00 PM_TAKE()         // take(native, recipient, amount)
    [DATA] mload 0x40 add calldataload [MEM_LOG] mstore
    [DATA] mload 0x20 add calldataload [DATA] mload calldataload __EVENT_HASH(NativeRedeemed) 0x20 [MEM_LOG] log3
    0x00 [MEM_LOG] RETURN_BYTES()
    bad_inner: 0x00 0x00 revert
}

//'########:'##::: ##:'########:'########::'##:::'##:
// ##.....:: ###:: ##:... ##..:: ##.... ##:. ##:'##::
// ##::::::: ####: ##:::: ##:::: ##:::: ##::. ####:::
// ######::: ## ## ##:::: ##:::: ########::::. ##::::
// ##...:::: ##. ####:::: ##:::: ##.. ##:::::: ##::::
// ##::::::: ##:. ###:::: ##:::: ##::. ##::::: ##::::
// ########: ##::. ##:::: ##:::: ##:::. ##:::: ##::::
//........::..::::..:::::..:::::..:::::..:::::..:::::
//
#define macro MAIN() = takes (0) returns (0) {
    0x20 [IMMUTABLES] 0x40 codecopy
    NON_PAYABLE()
    0x00 calldataload 0xe0 shr
    dup1 __FUNC_SIG("unlockCallback(bytes)") eq unlock_callback jumpi
    dup1 __FUNC_SIG("redeem(address,uint256)") eq redeem jumpi
    dup1 __FUNC_SIG("poolManager()") eq pool_manager jumpi
    0x00 0x00 revert

    unlock_callback: UNLOCK_CALLBACK()
    redeem:          REDEEM()
    pool_manager:    MANAGER() RETURN_1()
}
