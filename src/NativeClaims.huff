/// @title NativeClaims
/// @notice Redeems the caller's PoolManager native ETH claims to a chosen recipient.
/// @dev Huff build of `asyncswap/contracts` `src/NativeClaims.sol`. Approve this contract for native claim
///      ID 0 on PoolManager before redeeming. Constructor: `(IPoolManager manager)`. The reentrancy flag is
///      transient (it is set and cleared within one call, as the Solidity's storage flag is).

#include "./lib/Common.huff"
#include "./lib/PoolManager.huff"

