/// @title TokenClaims
/// @notice Redeems the caller's PoolManager currency claims to a chosen recipient.
/// @dev Huff build of `asyncswap/contracts` `src/TokenClaims.sol`. Approve this contract for the currency claim
///      ID on PoolManager before redeeming. Constructor: `(IPoolManager manager)`. The reentrancy flag is
///      transient (it is set and cleared within one call, as the Solidity's storage flag is).

#include "./lib/Common.huff"
#include "./lib/PoolManager.huff"

