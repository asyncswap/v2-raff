#define error NotPoolManager()
#define error HookNotImplemented()
#define error HookAddressNotValid(address)
#define error ExactInputOnly()
#define error UnaccountedNativeOutput()
#define error NotOwner()
#define error ZeroAddress()
#define error SignatureExpired()
#define error InvalidSignature()
#define error NonceAlreadyUsed()
#define error InvalidNumeraire()
#define error NumeraireRequired()
#define error DynamicFeeRequired()
#define error NotSelf()
#define error InvalidMatchBound()
#define error PartialLiquidityFill()
#define error LimitPriceNotMet()
#define error NoActiveLiquidity()
#define error SafeCastOverflow()
#define error WrappedError(address, bytes4, bytes, bytes)
#define error NativeTransferFailed()
#define error ERC20TransferFailed()

// Events
#define event HookSwap(bytes32 indexed, address indexed, int128, int128, uint128, uint128)
#define event OwnershipTransferred(address indexed, address indexed)
#define event OwnershipTransferStarted(address indexed, address indexed)
#define event Swept(address indexed, address indexed, uint256)
#define event NonceInvalidated(address indexed, uint256)
#define event ExecutorSet(bytes32 indexed, address indexed, address indexed, bool)
#define event AsyncOrdersMatched(bytes32 indexed, bytes32 indexed, bytes32 indexed, uint256, uint256)
#define event AsyncOrderLiquidityFilled(bytes32 indexed, bytes32 indexed, address indexed, uint256, uint256)
#define event AsyncOrderCreated(bytes32 indexed, bytes32 indexed, address indexed, bool, uint256, uint256, bytes32)
#define event AsyncOrderPriceUpdated(bytes32 indexed, bytes32 indexed, uint256, uint256)
#define event AsyncOrderFilled(bytes32 indexed, bytes32 indexed, address indexed, uint256, uint256)
#define event AsyncOrderCancelled(bytes32 indexed, bytes32 indexed, address indexed, uint256)
#define event OrderFeeAccrued(bytes32 indexed, address indexed, uint256)
#define event PriorityFeeDonated(bytes32 indexed, bytes32 indexed, address indexed, uint256)
#define event PriorityFeeForfeited(bytes32 indexed, bytes32 indexed, address indexed, uint256)
#define event OrderingModeChanged(bytes32 indexed, uint8)
#define event MinOrderSet(bytes32 indexed,uint256)

// Storage
//:'######::'########::'#######::'########:::::'###:::::'######:::'########:
//'##... ##:... ##..::'##.... ##: ##.... ##:::'## ##:::'##... ##:: ##.....::
