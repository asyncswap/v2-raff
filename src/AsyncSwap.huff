/// @title AsyncSwap
/// @notice Uniswap v4 hook that turns an exact-input swap into a resting limit order, escrowed as the hook's
///         ERC-6909 claims in the PoolManager, and matches, fills, cancels and reprices such orders.
/// @dev The Huff build of Async Swap v2 (`asyncswap/v2-from-proofs` `src/AsyncSwap.sol`, with
///      `HookSettlement`, `Owned2Step`, `AsyncFiller`, `AsyncMatching`, `RadixPriceTree`, `ProtocolFee`,
///      `OrderSignatures` and OpenZeppelin's `EIP712` / `SignatureChecker` inlined). Same ABI, events, errors
///      and behaviour. Spec: `asyncswap/v2-proofs` — `AsyncSwapProtocol/V2/Model.lean` (every entry point is a
///      body there), `V2/Spec.lean`, `V2/Settlement.lean`, `V2/Invariants.lean`, `AsyncSwapSpec/Book.lean`,
///      `Admin.lean`.
///
///      Constructor arguments (ABI-encoded after the creation code): `(IPoolManager manager, address feeVault,
///      Currency numeraire, address owner)`. The hook must be deployed at an address whose low 14 bits are
///      exactly BEFORE_INITIALIZE | BEFORE_SWAP | BEFORE_SWAP_RETURNS_DELTA (`0x2088`).

#include "./lib/Common.huff"
#include "./lib/Math.huff"
#include "./lib/RadixPriceTree.huff"
#include "./lib/Book.huff"
#include "./lib/PoolManager.huff"
#include "./lib/Signatures.huff"
#include "./lib/Owned2Step.huff"

/* ─────────────────────────────────────── errors ─────────────────────────────────────── */

#define error NotPoolManager()
#define error NotUnlocked()
#define error HookNotImplemented()
#define error ExactInputRequired()
#define error AmountTooLarge(uint256)
#define error ExecutorMismatch(address, address)
#define error UnauthorizedExecutor(address, address)
#define error NotOwnerOrExecutor(bytes32)
#define error InsufficientNativeDeposit(uint256, uint256)
#define error SignatureExpired(uint256)
#define error NonceAlreadyUsed(address, uint256)
#define error InvalidSignature()
#define error InvalidMaxMatches(uint256)
#define error NoActiveLiquidity()
#define error PartialLiquidityFill(uint256, uint256)
#define error LimitPriceNotMet(uint256, uint256)
#define error NativeTransferFailed()
#define error NumeraireRequired()
#define error DynamicFeeRequired()
#define error InvalidNumeraire()
#define error HookAddressNotValid(address)
#define error WrappedError(address, bytes4, bytes, bytes)
#define error ERC20TransferFailed()

/* ─────────────────────────────────────── events ─────────────────────────────────────── */

#define event OrderCreated(bytes32 indexed, bytes32 indexed, address indexed, bool, uint256, uint256, uint256, bytes32, uint64)
#define event OrderFilled(bytes32 indexed, bytes32 indexed, address indexed, uint256, uint256, uint256)
#define event OrderCancelled(bytes32 indexed, bytes32 indexed, uint256)
#define event OrdersMatched(bytes32 indexed, bytes32 indexed, bytes32 indexed, uint256, uint256)
#define event OrderReduced(bytes32 indexed, bytes32 indexed, uint256, uint256, uint64)
#define event OrderClosed(bytes32 indexed, bytes32 indexed, uint256)
#define event OrderRepriced(bytes32 indexed, bytes32 indexed, uint256, uint64)
#define event LiquidityFilled(bytes32 indexed, bytes32 indexed, uint256, uint256)
#define event ExecutorSet(bytes32 indexed, address indexed, address indexed, bool)
#define event NonceInvalidated(address indexed, uint256)
#define event OrderingModeSet(bytes32 indexed, uint8)
#define event Swept(address indexed, address indexed, uint256)
#define event PriorityFeeDonated(bytes32 indexed, uint256)
#define event PriorityFeeForfeited(bytes32 indexed, uint256)

/* ─────────────────────────────────────── storage ─────────────────────────────────────── */

#define constant OWNER_SLOT         = 0x00
#define constant PENDING_OWNER_SLOT = 0x01
#define constant NONCE_SEED         = 0x02   // nonceUsed[signer][nonce] = keccak(nonce, keccak(signer, 2))
#define constant POOLS_SEED         = 0x03   // pool state P = keccak(poolId, 3), see Book.huff

// Transient: native output deposited by the filler for the fill in progress, and the id assigned by the most
// recent `beforeSwap` (read back by the creating router).
#define constant PENDING_NATIVE_DEPOSIT_SLOT = 0xcfdfcbf5376ca0f2362e706e0788c579128e71eb589645733a61c956edacab2d
#define constant LAST_ORDER_ID_SLOT = 0xccb8eb2ed368d5ccf1b0cdb7da1c39638989397cf1225fc44df2a3a5c488d0b5

#define constant EIP712_NAME_HASH = 0x72bb025359d2292b4e59f168b9de8e3967bb96d5053211bfa4d833b6867bdb86 // "AsyncSwap"
#define constant SET_EXECUTOR_TYPEHASH = 0xe4479d9c4dc3f7c35677efc85aaca516cb63a3977aae04f893f8c6b86986c965
#define constant UPDATE_PRICE_TYPEHASH = 0xe175e7a62c398877a2c40c746d3d0aa115e2acfb47017d6517d70451225953a5

#define constant HOOK_FLAGS = 0x2088   // BEFORE_INITIALIZE | BEFORE_SWAP | BEFORE_SWAP_RETURNS_DELTA
#define constant ALL_HOOK_MASK = 0x3fff
#define constant DYNAMIC_FEE_FLAG = 0x800000
#define constant POOL_LIQUIDITY_FILL_FEE = 0x0bb8   // 0.30%
#define constant MAX_MATCHES_PER_CALL = 0x08
#define constant INT128_MAX = 0x7fffffffffffffffffffffffffffffff

/* ────────────────────────────────────── immutables ────────────────────────────────────── */

// The constructor appends (manager, feeVault, numeraire) to the runtime; MAIN copies them to 0x40–0x9f.
#define constant IMMUTABLES = __codesize(RUNTIME)

#define macro MANAGER() = takes (0) returns (1) { 0x40 mload }
#define macro FEE_VAULT() = takes (0) returns (1) { 0x60 mload }
#define macro NUMERAIRE() = takes (0) returns (1) { 0x80 mload }

/* ──────────────────────────────────── entry locals ──────────────────────────────────── */

#define constant E_PID    = 0x140   // poolId of the key at E_KEY
#define constant E_P      = 0x160   // pool state slot
#define constant E_ID     = 0x180
#define constant E_OWNER  = 0x1a0
#define constant E_ZFO    = 0x1c0
#define constant E_IN     = 0x1e0
#define constant E_MIN    = 0x200
#define constant E_FEE    = 0x220   // the order's bid
#define constant E_INPUT  = 0x240
#define constant E_OUTPUT = 0x260
#define constant E_X      = 0x280
#define constant E_Y      = 0x2a0
#define constant E_Z      = 0x2c0

#define constant M_COUNT      = 0x300
#define constant M_MAX        = 0x320
#define constant M_INC        = 0x340
#define constant M_SELL       = 0x360
#define constant M_BUY        = 0x380
#define constant M_ASSET      = 0x3a0
#define constant M_QUOTE      = 0x3c0
#define constant M_SELL_OWNER = 0x3e0
#define constant M_BUY_OWNER  = 0x400
#define constant M_INC_BUY    = 0x420
#define constant M_REST       = 0x440
#define constant R_ID         = 0x480
#define constant R_OWNER      = 0x4a0
#define constant R_INPUT      = 0x4c0
#define constant R_COUNTER    = 0x4e0
#define constant R_USED       = 0x500
#define constant R_REMIN      = 0x520
#define constant R_DONATED    = 0x540
#define constant R_REMFEE     = 0x560
#define constant R_CLOSED     = 0x580

/* ───────────────────────────────────── constructor ───────────────────────────────────── */

#define macro CONSTRUCTOR() = takes (0) returns (0) {
    // (manager, feeVault, numeraire, owner) → memory 0x00–0x7f
    0x80 dup1 codesize sub 0x00 codecopy

    // HookSettlement: the numeraire is a token, never native (bids are pulled with transferFrom).
    0x40 mload extcodesize has_code jumpi
    __ERROR(InvalidNumeraire) REVERT_0()
    has_code:

    0x60 mload OWNED_INIT()

    // Hooks.validateHookPermissions(this, getHookPermissions())
    address [ALL_HOOK_MASK] and [HOOK_FLAGS] eq valid jumpi
    address __ERROR(HookAddressNotValid) REVERT_1()
    valid:

    // runtime ‖ manager ‖ feeVault ‖ numeraire
    [IMMUTABLES] __codesize(CONSTRUCTOR) 0x100 codecopy
    0x60 0x00 [IMMUTABLES] 0x100 add mcopy
    [IMMUTABLES] 0x60 add 0x100 return
}

/* ─────────────────────────────────────── helpers ─────────────────────────────────────── */

#define macro ONLY_MANAGER() = takes (0) returns (0) {
    MANAGER() caller eq ok jumpi
    __ERROR(NotPoolManager) REVERT_0()
    ok:
}

#define macro WHEN_UNLOCKED() = takes (0) returns (0) {
    PM_IS_UNLOCKED() ok jumpi
    __ERROR(NotUnlocked) REVERT_0()
    ok:
}

/// @dev Copies the PoolKey at calldata `offset` to E_KEY; E_PID = its id, E_P = its state slot.
#define macro LOAD_KEY(offset) = takes (0) returns (0) {
    0xa0 <offset> [E_KEY] calldatacopy
    0xa0 [E_KEY] sha3 dup1 [E_PID] mstore
    [POOLS_SEED] swap1 HASH_2() [E_P] mstore
}

/// @dev `zeroForOne ? currency0 : currency1` of the key at E_KEY.
#define macro CURRENCY_IN() = takes (1) returns (1) {
    // [zeroForOne]
    0x05 shl 0xc0 sub mload
}

/// @dev `zeroForOne ? currency1 : currency0`.
#define macro CURRENCY_OUT() = takes (1) returns (1) {
    // [zeroForOne]
    0x05 shl 0xa0 add mload
}

/// @dev `nonceUsed[signer][nonce]` slot.
#define macro NONCE_SLOT() = takes (2) returns (1) {
    // [signer, nonce]
    [NONCE_SEED] swap1 HASH_2()     // [keccak(signer, 2), nonce]
    swap1 HASH_2()
}

/// @dev Loads the order `id` of the current pool: B_P, B_ID, B_O set; returns amountIn, reverting
///      `OrderNotFound(id)` when it is not open.
#define macro OPEN_ORDER() = takes (1) returns (1) {
    // [id]
    [B_ID] mstore
    [E_P] mload [B_P] mstore
    LOAD_OPEN_ORDER()
}

/// @dev `take(currency, to, amount, claims)`: as ERC-6909 claims (`mint`) or as tokens (`take`).
#define macro TAKE() = takes (4) returns (0) {
    // [claims, currency, to, amount]
    as_claims jumpi
    PM_TAKE() done jump
    as_claims:
    swap1 PM_MINT()
    done:
}

/// @notice `_transferEscrow` (`payOutBody`): burn the hook's escrow claim and pay the recipient — as ERC-6909
///         claims when the currency is native (redeemable through `NativeClaims`), as tokens otherwise.
#define fn TRANSFER_ESCROW() = takes (3) returns (0) {
    // [currency, recipient, amount]
    dup3 iszero skip jumpi
    dup3 dup2 address PM_BURN()                 // burn(this, currency, amount)
    dup1 iszero TAKE()
    done jump
    skip:
    pop pop pop
    done:
}

/// @notice `_settlePriorityFee` (`settleBidBody`): a bid is never refunded. It is donated to the pool's active
///         LPs; with no liquidity to receive it, it is forfeited to the vault. Either way the hook's numeraire
///         claim is burned.
#define fn SETTLE_PRIORITY_FEE() = takes (1) returns (0) {
    // [amount]
    dup1 iszero done jumpi
    [E_PID] mload PM_LIQUIDITY() iszero forfeit jumpi
    NUMERAIRE() [E_KEY] mload eq                // [numeraireIs0, amount]
    dup1 iszero dup3 mul                        // [amount1, numeraireIs0, amount]
    swap1 dup3 mul                              // [amount0, amount1, amount]
    PM_DONATE(0xa0)
    dup1 NUMERAIRE() address PM_BURN()
    dup1 [MEM_LOG] mstore
    [E_PID] mload __EVENT_HASH(PriorityFeeDonated) 0x20 [MEM_LOG] log2
    done jump
    forfeit:
    dup1 NUMERAIRE() address PM_BURN()
    dup1 NUMERAIRE() FEE_VAULT() PM_MINT()
    dup1 [MEM_LOG] mstore
    [E_PID] mload __EVENT_HASH(PriorityFeeForfeited) 0x20 [MEM_LOG] log2
    done:
    pop
}

/// @dev `_verify`: reject past `deadline`, burn the nonce, then check the signature (EOA or ERC-1271).
#define macro VERIFY() = takes (5) returns (0) {
    // [signer, nonce, deadline, digest, sigPos]
    dup3 timestamp gt iszero live jumpi
    dup3 __ERROR(SignatureExpired) REVERT_1()
    live:
    dup2 dup2 NONCE_SLOT()                      // [slot, signer, nonce, deadline, digest, sigPos]
    dup1 sload iszero fresh jumpi
    dup3 dup3 __ERROR(NonceAlreadyUsed) REVERT_2()
    fresh:
    0x01 swap1 sstore                           // [signer, nonce, deadline, digest, sigPos]
    swap1 pop swap1 pop                         // [signer, digest, sigPos]
    IS_VALID_SIGNATURE() valid jumpi
    __ERROR(InvalidSignature) REVERT_0()
    valid:
}

/// @dev Position of the length word of the `bytes` whose offset is at calldata `head`.
#define macro BYTES_POS(head) = takes (0) returns (1) {
    <head> calldataload 0x04 add
}

/// @dev Closes B_ID in the current pool and copies the closed order into E_OWNER, E_ZFO, E_IN, E_MIN, E_FEE,
///      E_INPUT, E_OUTPUT.
#define macro CLOSE_INTO_ENTRY() = takes (0) returns (0) {
    BOOK_CLOSE()
    [B_OWNER] mload [E_OWNER] mstore
    [B_ZFO] mload dup1 [E_ZFO] mstore
    dup1 CURRENCY_IN() [E_INPUT] mstore
    CURRENCY_OUT() [E_OUTPUT] mstore
    [B_IN] mload [E_IN] mstore
    [B_MIN] mload [E_MIN] mstore
    [B_FEE] mload [E_FEE] mstore
}

/* ──────────────────────────────── create (`beforeSwap`) ──────────────────────────────── */

/// @notice `beforeInitialize`: only pools that contain the numeraire, and only with the dynamic-fee flag.
#define macro BEFORE_INITIALIZE() = takes (0) returns (0) {
    ONLY_MANAGER()
    NUMERAIRE() 0x24 calldataload eq NUMERAIRE() 0x44 calldataload eq or has_numeraire jumpi
    __ERROR(NumeraireRequired) REVERT_0()
    has_numeraire:
    0x64 calldataload [DYNAMIC_FEE_FLAG] eq dynamic jumpi
    __ERROR(DynamicFeeRequired) REVERT_0()
    dynamic:
    __FUNC_SIG("beforeInitialize(address,(address,address,uint24,int24,address),uint160)") 0xe0 shl RETURN_1()
}

/// @notice `beforeSwap` (`_beforeSwap` + `_createOrder` + `addOrder`, `createBody`): the whole exact input
///         becomes the hook's claim and the order is opened; a non-zero bid is escrowed in the same call. The
///         caller of `PoolManager.swap` must be the maker's executor named in `hookData`.
#define macro BEFORE_SWAP() = takes (0) returns (0) {
    ONLY_MANAGER()
    // `fillFromPoolLiquidity` swaps the escrow through the pool: let the pool execute it.
    0x04 calldataload address eq self_swap jumpi

    0xe4 calldataload                           // [amountSpecified]
    0x00 dup2 slt exact_in jumpi
    __ERROR(ExactInputRequired) REVERT_0()
    exact_in:
    dup1 0x01 0xff shl eq iszero negatable jumpi
    PANIC(0x11)
    negatable:
    0x00 sub                                    // [amountIn]
    [INT128_MAX] dup2 gt iszero fits jumpi
    __ERROR(AmountTooLarge) REVERT_1()
    fits:
    [E_IN] mstore
    LOAD_KEY(0x24)
    LOAD_BOOL(0xc4) [E_ZFO] mstore

    // abi.decode(hookData, (UserParams)): user, executor, amountOutMin, priorityFee, salt
    BYTES_POS(0x124)                            // [lenPos]
    dup1 calldataload 0xa0 swap1 lt iszero decodable jumpi
    0x00 0x00 revert
    decodable:
    0x20 add                                    // [data]
    dup1 calldataload dup1 0xa0 shr bad_address jumpi
    [E_OWNER] mstore
    dup1 0x20 add calldataload dup1 0xa0 shr bad_address jumpi
    [E_X] mstore
    dup1 0x40 add calldataload [E_MIN] mstore
    dup1 0x60 add calldataload [E_FEE] mstore
    0x80 add calldataload [E_Y] mstore          // salt

    // _open
    0x04 calldataload [E_X] mload eq is_executor jumpi
    0x04 calldataload [E_X] mload __ERROR(ExecutorMismatch) REVERT_2()
    is_executor:
    0x04 calldataload [E_OWNER] mload [E_P] mload EXECUTOR_SLOT() sload authorized jumpi
    0x04 calldataload [E_OWNER] mload __ERROR(UnauthorizedExecutor) REVERT_2()
    authorized:

    CREATE_ORDER()
    [E_IN] mload [E_ZFO] mload CURRENCY_IN() address PM_MINT()
    [E_FEE] mload iszero no_bid jumpi
    [E_FEE] mload NUMERAIRE() address PM_MINT()
    no_bid:
    [E_ID] mload [LAST_ORDER_ID_SLOT] tstore

    __FUNC_SIG("beforeSwap(address,(address,address,uint24,int24,address),(bool,int256,uint160),bytes)") 0xe0 shl
    0x00 mstore
    [E_IN] mload 0x80 shl 0x20 mstore           // toBeforeSwapDelta(int128(amountIn), 0)
    0x00 0x40 mstore
    0x60 0x00 return

    bad_address:
    0x00 0x00 revert

    self_swap:
    __FUNC_SIG("beforeSwap(address,(address,address,uint24,int24,address),(bool,int256,uint160),bytes)") 0xe0 shl
    0x00 mstore
    0x00 0x20 mstore
    0x00 0x40 mstore
    0x60 0x00 return
}

/// @dev `orderId(poolId, owner, zeroForOne, salt) = keccak(abi.encode(chainid, poolId, owner, zeroForOne, salt))`.
#define macro ORDER_ID() = takes (3) returns (1) {
    // [owner, zeroForOne, salt]
    chainid [CALL_0] mstore
    [E_PID] mload 0xc20 mstore
    0xc40 mstore 0xc60 mstore 0xc80 mstore
    0xa0 [CALL_0] sha3
}

/// @notice `_createOrder`: walk the salt until the id is free, open the order, emit `OrderCreated`.
#define macro CREATE_ORDER() = takes (0) returns (0) {
    [E_Y] mload                                 // [salt]
    walk:
        dup1 [E_ZFO] mload [E_OWNER] mload ORDER_ID()      // [id, salt]
        dup1 [E_P] mload ORDER_SLOT() 0x02 add sload iszero free jumpi
        pop
        0x00 mstore 0x20 0x00 sha3              // salt = keccak(abi.encode(salt))
        walk jump
    free:                                       // [id, salt]
    [E_ID] mstore [E_Y] mstore

    [E_P] mload [B_P] mstore
    [E_ID] mload [B_ID] mstore
    [E_OWNER] mload [B_OWNER] mstore
    [E_ZFO] mload [B_ZFO] mstore
    [E_ZFO] mload CURRENCY_IN() NUMERAIRE() eq [B_BUY] mstore
    [E_IN] mload [B_IN] mstore
    [E_MIN] mload [B_MIN] mstore
    [E_FEE] mload [B_FEE] mstore
    BOOK_ADD()                                  // [sequence]

    // OrderCreated(poolId, id, owner, zeroForOne, amountIn, amountOutMin, priorityFee, salt, sequence)
    0xba0 mstore
    [E_ZFO] mload [MEM_LOG] mstore
    [E_IN] mload 0xb20 mstore
    [E_MIN] mload 0xb40 mstore
    [E_FEE] mload 0xb60 mstore
    [E_Y] mload 0xb80 mstore
    [E_OWNER] mload [E_ID] mload [E_PID] mload __EVENT_HASH(OrderCreated) 0xc0 [MEM_LOG] log4
}

/* ─────────────────────────────────────── matching ─────────────────────────────────────── */

/// @notice `matchNewOrder(key, id, maxMatches)`: match `id` against the best resting orders on the other side
///         while the book is crossed, at most `maxMatches ≤ 8` times.
#define macro MATCH_NEW_ORDER() = takes (0) returns (0) {
    WHEN_UNLOCKED()
    0xc4 calldataload dup1 [MAX_MATCHES_PER_CALL] lt iszero ok jumpi
    __ERROR(InvalidMaxMatches) REVERT_1()
    ok:
    [M_MAX] mstore
    LOAD_KEY(0x04)
    0xa4 calldataload [M_INC] mstore
    MATCH_INCOMING() RETURN_1()
}

/// @notice `matchBook(key, maxMatches)`: anyone continues a crossed book.
#define macro MATCH_BOOK() = takes (0) returns (0) {
    WHEN_UNLOCKED()
    0xa4 calldataload
    dup1 iszero bad jumpi
    dup1 [MAX_MATCHES_PER_CALL] lt bad jumpi
    [M_MAX] mstore
    LOAD_KEY(0x04)
    0x00 [M_COUNT] mstore
    loop:
        [M_MAX] mload [M_COUNT] mload lt iszero done jumpi
        0x01 [E_P] mload BOOK_BEST()            // [bidId, bidKey]
        dup1 iszero done_2 jumpi
        [M_BUY] mstore                          // [bidKey]
        0x00 [E_P] mload BOOK_BEST()            // [askId, askKey, bidKey]
        dup1 iszero done_3 jumpi
        [M_SELL] mstore                         // [askKey, bidKey]
        swap1 lt done jumpi                     // bidKey < askKey: not crossed
        MATCH_PAIR() iszero done jumpi
        [M_COUNT] mload 0x01 add [M_COUNT] mstore
        loop jump
    bad:
        __ERROR(InvalidMaxMatches) REVERT_1()
    done_3:
        pop
    done_2:
        pop pop
    done:
    [M_COUNT] mload RETURN_1()
}

/// @dev `_matchIncoming`: the crossed check is `ask key ≤ bid key` on the stored keys (`matchGuard`).
#define fn MATCH_INCOMING() = takes (0) returns (1) {
    0x00 [M_COUNT] mstore
    loop:
        [M_MAX] mload [M_COUNT] mload lt iszero done jumpi
        [M_INC] mload [E_P] mload ORDER_SLOT()  // [O]
        dup1 0x02 add sload iszero done_1 jumpi
        dup1 sload O_BUY() [M_INC_BUY] mstore
        0x01 add sload O_KEY()                  // [myKey]
        [M_INC_BUY] mload iszero [E_P] mload BOOK_BEST()   // [restingId, restingKey, myKey]
        dup1 iszero done_3 jumpi
        [M_REST] mstore                         // [restingKey, myKey]
        [M_INC_BUY] mload incoming_buy jumpi
        lt done jumpi                           // incoming sell: restingKey < myKey → not crossed
        [M_INC] mload [M_SELL] mstore
        [M_REST] mload [M_BUY] mstore
        pair jump
        incoming_buy:
        swap1 lt done jumpi                     // incoming buy: myKey < restingKey → not crossed
        [M_REST] mload [M_SELL] mstore
        [M_INC] mload [M_BUY] mstore
        pair:
        MATCH_PAIR() iszero done jumpi
        [M_COUNT] mload 0x01 add [M_COUNT] mstore
        loop jump
    done_3:
        pop pop
    done_1:
        pop
    done:
    [M_COUNT] mload
}

/// @dev `_matchPair(M_SELL, M_BUY)`: the older order rests and its price sizes the trade (`_matchAmounts`); a
///      zero result (rounding) is reported as "no match" and never executed. Then both sides are reduced.
#define fn MATCH_PAIR() = takes (0) returns (1) {
    [M_SELL] mload [E_P] mload ORDER_SLOT()     // [sO]
    [M_BUY] mload [E_P] mload ORDER_SLOT()      // [bO, sO]
    dup2 sload O_SEQ() dup2 sload O_SEQ() lt    // [restingBuy, bO, sO]
    dup2 0x03 add sload                         // buy.amountOutMin
    dup3 0x02 add sload                         // buy.amountIn
    dup5 0x03 add sload                         // sell.amountOutMin
    dup6 0x02 add sload                         // sell.amountIn
    MATCH_AMOUNTS()                             // [asset, quote, bO, sO]
    dup1 iszero no_match jumpi
    dup2 iszero no_match jumpi
    [M_ASSET] mstore [M_QUOTE] mstore           // [bO, sO]
    sload O_OWNER() [M_BUY_OWNER] mstore
    sload O_OWNER() [M_SELL_OWNER] mstore

    [M_SELL] mload [R_ID] mstore
    [M_BUY_OWNER] mload [R_COUNTER] mstore
    [M_QUOTE] mload [M_ASSET] mload REDUCE_AFTER_MATCH()
    [M_BUY] mload [R_ID] mstore
    [M_SELL_OWNER] mload [R_COUNTER] mstore
    [M_ASSET] mload [M_QUOTE] mload REDUCE_AFTER_MATCH()

    [M_ASSET] mload [MEM_LOG] mstore
    [M_QUOTE] mload 0xb20 mstore
    [M_BUY] mload [M_SELL] mload [E_PID] mload __EVENT_HASH(OrdersMatched) 0x40 [MEM_LOG] log4
    0x01 done jump

    no_match:
    pop pop pop pop 0x00
    done:
}

/// @dev `_transferEscrow` + `_settleMatchedPriorityFee` + `_reduceAfterMatch` for one side (`reduceSideBody`):
///      the consumed input goes to the counterparty, the pro-rata bid is donated, and the order either stays
///      open with reduced amounts or closes — settling the rest of its bid and refunding its unused input.
#define fn REDUCE_AFTER_MATCH() = takes (2) returns (0) {
    // [used, received]
    dup1 [R_USED] mstore
    [R_ID] mload [E_P] mload ORDER_SLOT() sload // [w0, used, received]
    dup1 O_OWNER() [R_OWNER] mstore
    O_ZFO() CURRENCY_IN() [R_INPUT] mstore      // [used, received]
    [E_P] mload [B_P] mstore
    [R_ID] mload [B_ID] mstore
    BOOK_REDUCE()                               // [closed, remainingIn, donatedFee, remainingFee]
    [R_CLOSED] mstore [R_REMIN] mstore [R_DONATED] mstore [R_REMFEE] mstore

    [R_USED] mload [R_COUNTER] mload [R_INPUT] mload TRANSFER_ESCROW()
    [R_DONATED] mload SETTLE_PRIORITY_FEE()
    [R_CLOSED] mload iszero reduced jumpi

    [R_REMFEE] mload SETTLE_PRIORITY_FEE()
    [R_REMIN] mload [R_OWNER] mload [R_INPUT] mload TRANSFER_ESCROW()
    [R_REMIN] mload [MEM_LOG] mstore
    [R_ID] mload [E_PID] mload __EVENT_HASH(OrderClosed) 0x20 [MEM_LOG] log3
    done jump

    reduced:
    [R_REMIN] mload [MEM_LOG] mstore
    [R_ID] mload [E_P] mload ORDER_SLOT() 0x03 add sload 0xb20 mstore
    [R_REMFEE] mload 0xb40 mstore
    [R_ID] mload [E_PID] mload __EVENT_HASH(OrderReduced) 0x60 [MEM_LOG] log3
    done:
}

/* ──────────────────────────────────── fill / cancel ──────────────────────────────────── */

/// @notice `executeOrder(key, id, filler)` (`fillBody`): an executor fills the order in full. The executor has
///         already delivered the live gross output — `amountOutMin + calculatePoolFee(amountOutMin)` — as native
///         value forwarded to this contract or as a `settleFor(hook)` credit. The maker receives exactly the
///         stored minimum, the vault the fee, the filler the whole escrow; the bid is settled.
#define macro EXECUTE_ORDER() = takes (0) returns (0) {
    WHEN_UNLOCKED()
    LOAD_KEY(0x04)
    0xa4 calldataload dup1 [E_ID] mstore
    LOAD_ADDRESS(0xc4) [E_X] mstore             // filler
    OPEN_ORDER() pop
    caller [B_O] mload sload O_OWNER() [E_P] mload EXECUTOR_SLOT() sload authorized jumpi
    caller [B_O] mload sload O_OWNER() __ERROR(UnauthorizedExecutor) REVERT_2()
    authorized:
    CLOSE_INTO_ENTRY()

    [E_MIN] mload POOL_FEE() dup1 [E_Y] mstore  // fee
    [E_MIN] mload CHECKED_ADD() [E_Z] mstore    // live = amountOutMin + fee

    [E_OUTPUT] mload paid_in_tokens jumpi
    [PENDING_NATIVE_DEPOSIT_SLOT] tload         // [pending]
    [E_Z] mload dup2 lt iszero covered jumpi
    [E_Z] mload __ERROR(InsufficientNativeDeposit) REVERT_2()
    covered:
    [E_Z] mload swap1 sub [PENDING_NATIVE_DEPOSIT_SLOT] tstore
    [E_Z] mload PM_SETTLE()
    paid_in_tokens:

    [E_MIN] mload [E_OWNER] mload [E_OUTPUT] mload dup1 iszero TAKE()
    [E_Y] mload iszero no_fee jumpi
    [E_Y] mload [E_OUTPUT] mload FEE_VAULT() PM_MINT()
    no_fee:
    [E_IN] mload [E_X] mload [E_INPUT] mload TRANSFER_ESCROW()
    [E_FEE] mload SETTLE_PRIORITY_FEE()
    0x00 [PENDING_NATIVE_DEPOSIT_SLOT] tstore

    [E_IN] mload [MEM_LOG] mstore
    [E_MIN] mload 0xb20 mstore
    [E_Y] mload 0xb40 mstore
    [E_X] mload [E_ID] mload [E_PID] mload __EVENT_HASH(OrderFilled) 0x60 [MEM_LOG] log4

    [E_IN] mload 0x00 mstore
    [E_MIN] mload 0x20 mstore
    [E_Y] mload 0x40 mstore
    0x60 0x00 return
}

/// @notice `cancelOrder(key, id)` (`cancelBody`): the maker, or an executor the maker granted, closes the
///         order. The remaining escrow is refunded to the maker; the bid is not.
#define macro CANCEL_ORDER() = takes (0) returns (0) {
    WHEN_UNLOCKED()
    LOAD_KEY(0x04)
    0xa4 calldataload dup1 [E_ID] mstore
    OPEN_ORDER() pop
    [B_O] mload sload O_OWNER()                 // [owner]
    dup1 caller eq allowed jumpi
    caller dup2 [E_P] mload EXECUTOR_SLOT() sload allowed jumpi
    [E_ID] mload __ERROR(NotOwnerOrExecutor) REVERT_1()
    allowed:
    pop
    CLOSE_INTO_ENTRY()
    [E_IN] mload [E_OWNER] mload [E_INPUT] mload TRANSFER_ESCROW()
    [E_FEE] mload SETTLE_PRIORITY_FEE()
    [E_IN] mload [MEM_LOG] mstore
    [E_ID] mload [E_PID] mload __EVENT_HASH(OrderCancelled) 0x20 [MEM_LOG] log3
    [E_IN] mload RETURN_1()
}

/// @notice `fillFromPoolLiquidity(key, id)` (`liquidityFillBody`): anyone swaps the whole escrow through the
///         pool; the maker is paid the pool's output, which must reach their minimum.
#define macro FILL_FROM_POOL_LIQUIDITY() = takes (0) returns (0) {
    WHEN_UNLOCKED()
    LOAD_KEY(0x04)
    0xa4 calldataload dup1 [E_ID] mstore
    OPEN_ORDER() pop
    [E_PID] mload PM_LIQUIDITY() has_liquidity jumpi
    __ERROR(NoActiveLiquidity) REVERT_0()
    has_liquidity:
    CLOSE_INTO_ENTRY()

    [E_IN] mload [E_INPUT] mload address PM_BURN()
    // A dynamic-fee pool starts at 0, and this is the only swap that reaches the pool's liquidity.
    [POOL_LIQUIDITY_FILL_FEE] PM_UPDATE_DYNAMIC_FEE(0xa0)
    [MAX_SQRT_PRICE_MINUS_ONE] [E_ZFO] mload iszero limit jumpi
    pop [MIN_SQRT_PRICE_PLUS_ONE]
    limit:                                      // [sqrtPriceLimit]
    [E_IN] mload 0x00 sub                       // [−amountIn, limit]
    [E_ZFO] mload PM_SWAP(0xa0)                 // [delta]
    dup1 0x80 sar                               // [amount0, delta]
    swap1 0x0f signextend                       // [amount1, amount0]
    [E_ZFO] mload iszero ordered jumpi          // !zeroForOne: (in, out) = (amount1, amount0)
    swap1                                       // zeroForOne:  (in, out) = (amount0, amount1)
    ordered:                                    // [deltaIn, deltaOut]
    dup1 [E_IN] mload 0x00 sub eq whole jumpi
    0x00 sub [UINT128_MASK] and [E_IN] mload __ERROR(PartialLiquidityFill) REVERT_2()
    whole:
    pop [UINT128_MASK] and                      // [amountOut]
    dup1 [E_MIN] mload gt iszero limit_met jumpi
    dup1 [E_MIN] mload __ERROR(LimitPriceNotMet) REVERT_2()
    limit_met:
    dup1 [E_X] mstore
    [E_OWNER] mload [E_OUTPUT] mload dup1 iszero TAKE()
    [E_FEE] mload SETTLE_PRIORITY_FEE()
    [E_IN] mload [MEM_LOG] mstore
    [E_X] mload 0xb20 mstore
    [E_ID] mload [E_PID] mload __EVENT_HASH(LiquidityFilled) 0x40 [MEM_LOG] log3
    [E_X] mload RETURN_1()
}

/* ──────────────────────────────────── maker actions ──────────────────────────────────── */

#define macro EMIT_REPRICED() = takes (1) returns (0) {
    // [sequence]
    0xb20 mstore
    [E_MIN] mload [MEM_LOG] mstore
    [E_ID] mload [E_PID] mload __EVENT_HASH(OrderRepriced) 0x40 [MEM_LOG] log3
}

/// @notice `updatePrice(key, id, newAmountOutMin)`: maker-only; no claims move; the order re-enters its level
///         last.
#define macro UPDATE_PRICE() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    0xa4 calldataload [E_ID] mstore
    0xc4 calldataload [E_MIN] mstore
    [E_P] mload [B_P] mstore
    [E_ID] mload [B_ID] mstore
    [E_MIN] mload caller BOOK_UPDATE_PRICE()    // [sequence]
    EMIT_REPRICED()
    RETURN_EMPTY()
}

/// @notice `updatePriceWithSig(key, id, newAmountOutMin, nonce, deadline, signature)`: the maker signs
///         `UpdatePrice(maker, tokenIn, tokenOut, amountIn(stored), newAmountOutMin, orderId, nonce, deadline)`.
#define macro UPDATE_PRICE_WITH_SIG() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    0xa4 calldataload dup1 [E_ID] mstore
    0xc4 calldataload [E_MIN] mstore
    OPEN_ORDER()                                // [amountIn]
    [B_O] mload sload                           // [w0, amountIn]
    dup1 O_OWNER() [E_OWNER] mstore
    O_ZFO()                                     // [zeroForOne, amountIn]
    [UPDATE_PRICE_TYPEHASH] [S_STRUCT] mstore
    [E_OWNER] mload 0x10e0 mstore
    dup1 CURRENCY_IN() 0x1100 mstore
    CURRENCY_OUT() 0x1120 mstore
    0x1140 mstore                               // amountIn
    [E_MIN] mload 0x1160 mstore
    [E_ID] mload 0x1180 mstore
    0xe4 calldataload 0x11a0 mstore             // nonce
    0x104 calldataload 0x11c0 mstore            // deadline
    0x120 [S_STRUCT] sha3 HASH_TYPED_DATA()     // [digest]
    BYTES_POS(0x124) swap1                      // [digest, sigPos]
    0x104 calldataload 0xe4 calldataload [E_OWNER] mload VERIFY()
    [E_P] mload [B_P] mstore
    [E_ID] mload [B_ID] mstore
    [E_MIN] mload [E_OWNER] mload BOOK_UPDATE_PRICE()
    EMIT_REPRICED()
    RETURN_EMPTY()
}

#define macro EMIT_EXECUTOR_SET() = takes (3) returns (0) {
    // [maker, executor, allow]
    swap2 [MEM_LOG] mstore                      // [executor, maker]
    swap1 [E_PID] mload __EVENT_HASH(ExecutorSet) 0x20 [MEM_LOG] log4
}

/// @notice `setExecutor(key, executor, allow)`: grant or revoke an executor for the caller's orders in `key`.
#define macro SET_EXECUTOR() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    LOAD_BOOL(0xc4)                             // [allow]
    LOAD_ADDRESS(0xa4)                          // [executor, allow]
    dup2 dup2 caller [E_P] mload EXECUTOR_SLOT() sstore
    caller EMIT_EXECUTOR_SET()
    RETURN_EMPTY()
}

/// @notice `setExecutorWithSig(key, maker, executor, allow, nonce, deadline, signature)`:
///         `SetExecutor(maker, executor, allow, pool, nonce, deadline)` signed by the maker.
#define macro SET_EXECUTOR_WITH_SIG() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    HASH_POOL_KEY()                             // [poolHash]
    [SET_EXECUTOR_TYPEHASH] [S_STRUCT] mstore
    LOAD_ADDRESS(0xa4) 0x10e0 mstore            // maker
    LOAD_ADDRESS(0xc4) 0x1100 mstore            // executor
    LOAD_BOOL(0xe4) 0x1120 mstore               // allow
    0x1140 mstore                               // pool
    0x104 calldataload 0x1160 mstore            // nonce
    0x124 calldataload 0x1180 mstore            // deadline
    0xe0 [S_STRUCT] sha3 HASH_TYPED_DATA()      // [digest]
    BYTES_POS(0x144) swap1                      // [digest, sigPos]
    0x124 calldataload 0x104 calldataload 0xa4 calldataload VERIFY()
    0xe4 calldataload 0xc4 calldataload dup2 dup2 0xa4 calldataload [E_P] mload EXECUTOR_SLOT() sstore
    0xa4 calldataload EMIT_EXECUTOR_SET()
    RETURN_EMPTY()
}

/// @notice `invalidateNonce(nonce)`: burn one of the caller's nonces so a signature carrying it can never be used.
#define macro INVALIDATE_NONCE() = takes (0) returns (0) {
    0x04 calldataload caller NONCE_SLOT()       // [slot]
    dup1 sload iszero fresh jumpi
    0x04 calldataload caller __ERROR(NonceAlreadyUsed) REVERT_2()
    fresh:
    0x01 swap1 sstore
    0x04 calldataload [MEM_LOG] mstore
    caller __EVENT_HASH(NonceInvalidated) 0x20 [MEM_LOG] log2
    RETURN_EMPTY()
}

/* ──────────────────────────────────────── admin ──────────────────────────────────────── */

/// @notice `setOrderingMode(key, mode)`: owner-only, only while the pool's book is empty.
#define macro SET_ORDERING_MODE() = takes (0) returns (0) {
    0xa4 calldataload dup1 0x01 lt iszero valid jumpi
    0x00 0x00 revert
    valid:                                      // [mode]
    ONLY_OWNER()
    LOAD_KEY(0x04)
    dup1 [E_P] mload BOOK_SET_MODE()
    [MEM_LOG] mstore
    [E_PID] mload __EVENT_HASH(OrderingModeSet) 0x20 [MEM_LOG] log2
    RETURN_EMPTY()
}

/// @notice `sweep(currency, to)`: move this contract's *own* token balance (never claims, so never escrow).
#define macro SWEEP() = takes (0) returns (0) {
    ONLY_OWNER()
    LOAD_ADDRESS(0x24)                          // [to]
    dup1 has_to jumpi
    __ERROR(ZeroAddress) REVERT_0()
    has_to:
    LOAD_ADDRESS(0x04)                          // [currency, to]
    dup1 token jumpi
    selfbalance                                 // [amount, currency, to]
    measured jump
    token:
    __FUNC_SIG("balanceOf(address)") CALL_SELECTOR()
    address [CALL_4] mstore
    0x20 [CALL_0] 0x24 [CALL_0] dup5 gas staticcall
    ok jumpi
    BUBBLE()
    ok:
    0x20 returndatasize lt iszero word jumpi
    0x00 0x00 revert
    word:
    [CALL_0] mload                              // [amount, currency, to]
    measured:
    dup1 iszero emit jumpi
    dup1 dup4 dup4 TRANSFER_CURRENCY()
    emit:
    dup1 [MEM_LOG] mstore
    dup3 dup3 __EVENT_HASH(Swept) 0x20 [MEM_LOG] log3
    RETURN_1()
}

/// @dev v4 `CustomRevert.bubbleUpAndRevertWith(target, fnSelector, context)`: revert with
///      `WrappedError(target, fnSelector, <last revert data>, context)`.
#define macro WRAPPED_REVERT() = takes (3) returns (0) {
    // [target, fnSelector, contextSelector]   (selectors left-aligned)
    __ERROR(WrappedError) [CALL_0] mstore
    [CALL_4] mstore
    [CALL_24] mstore
    0x80 [CALL_44] mstore
    returndatasize 0x1f add 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0 and   // [enc, ctx]
    dup1 0xa0 add [CALL_64] mstore
    returndatasize [CALL_84] mstore
    returndatasize 0x00 [CALL_A4] returndatacopy
    0x04 dup2 [CALL_A4] add mstore
    swap1 dup2 [CALL_C4] add mstore             // [enc]
    0xe4 add [CALL_0] revert
}

/// @dev v4 `Currency.transfer(currency, to, amount)`.
#define macro TRANSFER_CURRENCY() = takes (3) returns (0) {
    // [currency, to, amount]
    dup1 erc20 jumpi
    pop                                         // [to, amount]
    0x00 0x00 0x00 0x00 dup6 dup6 gas call
    sent jumpi
    __ERROR(NativeTransferFailed) 0x00 dup3 WRAPPED_REVERT()
    sent:
    pop pop
    done jump

    erc20:
    __FUNC_SIG("transfer(address,uint256)") CALL_SELECTOR()
    swap1 [CALL_4] mstore
    swap1 [CALL_24] mstore                      // [currency]
    0x20 0x00 0x44 [CALL_0] 0x00 dup6 gas call  // [ok, currency]
    0x1f returndatasize gt 0x00 mload 0x01 eq and
    returndatasize iszero or and
    transferred jumpi
    __ERROR(ERC20TransferFailed) __FUNC_SIG("transfer(address,uint256)") 0xe0 shl dup3 WRAPPED_REVERT()
    transferred:
    pop
    done:
}

/* ──────────────────────────────────────── views ──────────────────────────────────────── */

/// @notice `getOrder(key, id)` → `AsyncFiller.OrderInfo` (owner, zeroForOne, buy, priorityFee, sequence,
///         priceKey, priorityKey, amountIn, amountOutMin, previous, next).
#define macro GET_ORDER() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    0xa4 calldataload [E_P] mload ORDER_SLOT()  // [O]
    dup1 sload                                  // [w0, O]
    dup1 O_OWNER() [CALL_0] mstore
    dup1 O_ZFO() 0xc20 mstore
    dup1 O_BUY() 0xc40 mstore
    O_SEQ() 0xc80 mstore                        // [O]
    dup1 0x01 add sload                         // [w1, O]
    dup1 O_FEE() 0xc60 mstore
    O_KEY() 0xca0 mstore
    dup1 0x02 add sload dup1 0xce0 mstore       // [amountIn, O]
    0x00 0xcc0 mstore
    iszero no_priority jumpi
    [E_P] mload ORDERING_MODE() iszero no_priority jumpi
    0xc80 mload 0xc60 mload PRIORITY_KEY() 0xcc0 mstore
    no_priority:
    dup1 0x03 add sload 0xd00 mstore
    dup1 0x04 add sload 0xd20 mstore
    0x05 add sload 0xd40 mstore
    0x160 [CALL_0] return
}

#define macro IS_EXECUTOR() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    LOAD_ADDRESS(0xc4) LOAD_ADDRESS(0xa4) [E_P] mload EXECUTOR_SLOT() sload RETURN_1()
}

#define macro BEST_ORDER() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    LOAD_BOOL(0xa4) [E_P] mload BOOK_BEST() RETURN_2()
}

#define macro ORDERING_MODE_VIEW() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    [E_P] mload ORDERING_MODE() RETURN_1()
}

#define macro OPEN_ORDERS() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    [E_P] mload 0x01 add sload RETURN_1()
}

#define macro NEXT_SEQUENCE_VIEW() = takes (0) returns (0) {
    LOAD_KEY(0x04)
    [E_P] mload sload 0x08 shr [UINT64_MASK] and RETURN_1()
}

#define macro NONCE_USED() = takes (0) returns (0) {
    0x24 calldataload LOAD_ADDRESS(0x04) NONCE_SLOT() sload RETURN_1()
}

#define macro CALCULATE_POOL_FEE() = takes (0) returns (0) {
    0x04 calldataload 0x18 shr iszero valid jumpi
    0x00 0x00 revert
    valid:
    0x24 calldataload POOL_FEE() RETURN_1()
}

#define macro GET_HOOK_PERMISSIONS() = takes (0) returns (0) {
    // beforeInitialize, beforeSwap, beforeSwapReturnDelta
    0x01 0x00 mstore
    0x00 0x20 mstore 0x00 0x40 mstore 0x00 0x60 mstore 0x00 0x80 mstore 0x00 0xa0 mstore
    0x01 0xc0 mstore
    0x00 0xe0 mstore 0x00 0x100 mstore 0x00 0x120 mstore
    0x01 0x140 mstore
    0x00 0x160 mstore 0x00 0x180 mstore 0x00 0x1a0 mstore
    0x1c0 0x00 return
}

/// @notice ERC-5267 `eip712Domain()`: (0x0f, "AsyncSwap", "2", chainid, this, 0, []).
#define macro EIP712_DOMAIN() = takes (0) returns (0) {
    0x0f 0xf8 shl 0x00 mstore
    0xe0 0x20 mstore
    0x120 0x40 mstore
    chainid 0x60 mstore
    address 0x80 mstore
    0x00 0xa0 mstore
    0x160 0xc0 mstore
    0x09 0xe0 mstore
    __RIGHTPAD(0x4173796e6353776170) 0x100 mstore   // "AsyncSwap"
    0x01 0x120 mstore
    __RIGHTPAD(0x32) 0x140 mstore                   // "2"
    0x00 0x160 mstore
    0x180 0x00 return
}

/* ──────────────────────────────────────── main ──────────────────────────────────────── */

#define macro MAIN() = takes (0) returns (0) {
    0x60 [IMMUTABLES] 0x40 codecopy

    // receive(): feeds the transient native ledger a filler's deposit is forwarded into.
    calldatasize receive jumpi
    [PENDING_NATIVE_DEPOSIT_SLOT] tload callvalue add [PENDING_NATIVE_DEPOSIT_SLOT] tstore
    stop
    receive:
    NON_PAYABLE()

    0x00 calldataload 0xe0 shr
    dup1 __FUNC_SIG("beforeSwap(address,(address,address,uint24,int24,address),(bool,int256,uint160),bytes)") eq before_swap jumpi
    dup1 __FUNC_SIG("matchNewOrder((address,address,uint24,int24,address),bytes32,uint256)") eq match_new_order jumpi
    dup1 __FUNC_SIG("lastOrderId()") eq last_order_id jumpi
    dup1 __FUNC_SIG("executeOrder((address,address,uint24,int24,address),bytes32,address)") eq execute_order jumpi
    dup1 __FUNC_SIG("getOrder((address,address,uint24,int24,address),bytes32)") eq get_order jumpi
    dup1 __FUNC_SIG("calculatePoolFee(uint24,uint256)") eq calculate_pool_fee jumpi
    dup1 __FUNC_SIG("isExecutor((address,address,uint24,int24,address),address,address)") eq is_executor jumpi
    dup1 __FUNC_SIG("cancelOrder((address,address,uint24,int24,address),bytes32)") eq cancel_order jumpi
    dup1 __FUNC_SIG("matchBook((address,address,uint24,int24,address),uint256)") eq match_book jumpi
    dup1 __FUNC_SIG("fillFromPoolLiquidity((address,address,uint24,int24,address),bytes32)") eq fill_from_pool_liquidity jumpi
    dup1 __FUNC_SIG("numeraire()") eq numeraire jumpi
    dup1 __FUNC_SIG("setExecutorWithSig((address,address,uint24,int24,address),address,address,bool,uint256,uint256,bytes)") eq set_executor_with_sig jumpi
    dup1 __FUNC_SIG("bestOrder((address,address,uint24,int24,address),bool)") eq best_order jumpi
    dup1 __FUNC_SIG("updatePrice((address,address,uint24,int24,address),bytes32,uint256)") eq update_price jumpi
    dup1 __FUNC_SIG("updatePriceWithSig((address,address,uint24,int24,address),bytes32,uint256,uint256,uint256,bytes)") eq update_price_with_sig jumpi
    dup1 __FUNC_SIG("setExecutor((address,address,uint24,int24,address),address,bool)") eq set_executor jumpi
    dup1 __FUNC_SIG("beforeInitialize(address,(address,address,uint24,int24,address),uint160)") eq before_initialize jumpi
    dup1 __FUNC_SIG("openOrders((address,address,uint24,int24,address))") eq open_orders jumpi
    dup1 __FUNC_SIG("orderingMode((address,address,uint24,int24,address))") eq ordering_mode jumpi
    dup1 __FUNC_SIG("nextSequence((address,address,uint24,int24,address))") eq next_sequence jumpi
    dup1 __FUNC_SIG("invalidateNonce(uint256)") eq invalidate_nonce jumpi
    dup1 __FUNC_SIG("nonceUsed(address,uint256)") eq nonce_used jumpi
    dup1 __FUNC_SIG("pendingNativeDeposit()") eq pending_native_deposit jumpi
    dup1 __FUNC_SIG("DOMAIN_SEPARATOR()") eq domain_separator jumpi
    dup1 __FUNC_SIG("eip712Domain()") eq eip712_domain jumpi
    dup1 __FUNC_SIG("setOrderingMode((address,address,uint24,int24,address),uint8)") eq set_ordering_mode jumpi
    dup1 __FUNC_SIG("sweep(address,address)") eq sweep jumpi
    dup1 __FUNC_SIG("owner()") eq owner jumpi
    dup1 __FUNC_SIG("pendingOwner()") eq pending_owner jumpi
    dup1 __FUNC_SIG("transferOwnership(address)") eq transfer_ownership jumpi
    dup1 __FUNC_SIG("acceptOwnership()") eq accept_ownership jumpi
    dup1 __FUNC_SIG("manager()") eq manager jumpi
    dup1 __FUNC_SIG("feeVault()") eq fee_vault jumpi
    dup1 __FUNC_SIG("MAX_MATCHES_PER_CALL()") eq max_matches jumpi
    dup1 __FUNC_SIG("POOL_LIQUIDITY_FILL_FEE()") eq pool_liquidity_fill_fee jumpi
    dup1 __FUNC_SIG("getHookPermissions()") eq get_hook_permissions jumpi
    dup1 __FUNC_SIG("afterInitialize(address,(address,address,uint24,int24,address),uint160,int24)") eq not_implemented jumpi
    dup1 __FUNC_SIG("beforeAddLiquidity(address,(address,address,uint24,int24,address),(int24,int24,int256,bytes32),bytes)") eq not_implemented jumpi
    dup1 __FUNC_SIG("afterAddLiquidity(address,(address,address,uint24,int24,address),(int24,int24,int256,bytes32),int256,int256,bytes)") eq not_implemented jumpi
    dup1 __FUNC_SIG("beforeRemoveLiquidity(address,(address,address,uint24,int24,address),(int24,int24,int256,bytes32),bytes)") eq not_implemented jumpi
    dup1 __FUNC_SIG("afterRemoveLiquidity(address,(address,address,uint24,int24,address),(int24,int24,int256,bytes32),int256,int256,bytes)") eq not_implemented jumpi
    dup1 __FUNC_SIG("afterSwap(address,(address,address,uint24,int24,address),(bool,int256,uint160),int256,bytes)") eq not_implemented jumpi
    dup1 __FUNC_SIG("beforeDonate(address,(address,address,uint24,int24,address),uint256,uint256,bytes)") eq not_implemented jumpi
    dup1 __FUNC_SIG("afterDonate(address,(address,address,uint24,int24,address),uint256,uint256,bytes)") eq not_implemented jumpi
    0x00 0x00 revert

    before_swap:              BEFORE_SWAP()
    match_new_order:          MATCH_NEW_ORDER()
    last_order_id:            [LAST_ORDER_ID_SLOT] tload RETURN_1()
    execute_order:            EXECUTE_ORDER()
    get_order:                GET_ORDER()
    calculate_pool_fee:       CALCULATE_POOL_FEE()
    is_executor:              IS_EXECUTOR()
    cancel_order:             CANCEL_ORDER()
    match_book:               MATCH_BOOK()
    fill_from_pool_liquidity: FILL_FROM_POOL_LIQUIDITY()
    numeraire:                NUMERAIRE() RETURN_1()
    set_executor_with_sig:    SET_EXECUTOR_WITH_SIG()
    best_order:               BEST_ORDER()
    update_price:             UPDATE_PRICE()
    update_price_with_sig:    UPDATE_PRICE_WITH_SIG()
    set_executor:             SET_EXECUTOR()
    before_initialize:        BEFORE_INITIALIZE()
    open_orders:              OPEN_ORDERS()
    ordering_mode:            ORDERING_MODE_VIEW()
    next_sequence:            NEXT_SEQUENCE_VIEW()
    invalidate_nonce:         INVALIDATE_NONCE()
    nonce_used:               NONCE_USED()
    pending_native_deposit:   [PENDING_NATIVE_DEPOSIT_SLOT] tload RETURN_1()
    domain_separator:         DOMAIN_SEPARATOR() RETURN_1()
    eip712_domain:            EIP712_DOMAIN()
    set_ordering_mode:        SET_ORDERING_MODE()
    sweep:                    SWEEP()
    owner:                    [OWNER_SLOT] sload RETURN_1()
    pending_owner:            [PENDING_OWNER_SLOT] sload RETURN_1()
    transfer_ownership:       TRANSFER_OWNERSHIP()
    accept_ownership:         ACCEPT_OWNERSHIP()
    manager:                  MANAGER() RETURN_1()
    fee_vault:                FEE_VAULT() RETURN_1()
    max_matches:              [MAX_MATCHES_PER_CALL] RETURN_1()
    pool_liquidity_fill_fee:  [POOL_LIQUIDITY_FILL_FEE] RETURN_1()
    get_hook_permissions:     GET_HOOK_PERMISSIONS()
    not_implemented:          __ERROR(HookNotImplemented) REVERT_0()
}
