/// @title Book
/// @notice Per-pool order storage and the price-time book: `asyncswap/contracts` `AsyncFiller` (storage half).
/// @dev A pool's state hangs off `P = keccak(poolId, POOLS_SEED)`:
///        P + 0   header: nextSequence (bits 0–63) | openOrderCount (64–127) | orderingMode (128–135)
///        P + 1   bid price tree (`RadixPriceTree`)
///        P + 2   ask price tree
///        P + 3   orders:      keccak(id, P + 3)                      → order record, 7 slots
///        P + 4   executors:   keccak(executor, keccak(maker, P + 4)) → bool
///        P + 5   bid levels:  keccak(price, P + 5)                   → level
///        P + 6   ask levels:  keccak(price, P + 6)                   → level
///        P + 7   initialized: set by `beforeInitialize` (the `asyncOrders(poolId)` getter)
///
///      Order record `O` (`AsyncFiller.OrderInfo`):
///        O + 0   owner (0–159) | isBuy (160) | zeroForOne (168) | priorityFeeEscrowed (176) | priorityFee (184–247)
///        O + 1   price (0–127) | priorityKey (128–255)
///        O + 2   amountIn (0 = no such order)
///        O + 3   amountOutMin
///        O + 4   createdSequence (0–63) | queue sequence (64–127)
///        O + 5/6 unused
///
///      Level `L` (`PriceLevel`): L + 0 head, L + 1 tail, L + 2 orderCount, L + 3 priority tree,
///      L + 4 seed of `priorityOrderIds[priorityKey] = keccak(priorityKey, L + 4)`.

//.sSSSSs.    .sSSSSs.    .sSSSSs.    .sSSSSs.                     SsSSs.
//SSSSSSSSSs. SSSSSSSSSs. SSSSSSSSSs. SSSSSSSSSs.      .sSSS s.      SSSSs
//S SSS SSSSS S SSS SSSSS S SSS SSSS' S SSS SSSS'      S SSS SSSs.   S SSS
//S  SS SSSS' S  SS SSSSS S  SS       S  SS            S  SS SSSSS   S  SS
//S..SSsSSSa. S..SSsSSSSS S..SSsss    S..SSsss         S..SS SSSSS   S..SS
//S:::S SSSSS S:::S SSSSS S:::SSSS    S:::SSSS          S::S SSSS    S:::S
//S;;;S SSSSS S;;;S SSSSS S;;;S       S;;;S              S;S SSS     S;;;S
//S%%%S SSSSS S%%%S SSSSS S%%%S       S%%%S               SS SS      S%%%S
//SSSSS SSSSS SSSSS SSSSS SSSSS       SSSSS                SsS     SsSSSSSsS
//
//    r   fGr
//  rr  GrGGrG
//rrr       GraG
//r          GfrrraGa
//r             GaarrrrrrGr
//              GrarrrrrGrG
//               GaGfra GraG
//               Ga ar    ff
//               Ga  Gr    G
//              fr   af    Gr
//             Gr    Gr    G
//_mmsaki 2025 ________________

//'####:'##::: ##:'########:'########:'########::'########::::'###:::::'######::'########:
//. ##:: ###:: ##:... ##..:: ##.....:: ##.... ##: ##.....::::'## ##:::'##... ##: ##.....::
//: ##:: ####: ##:::: ##:::: ##::::::: ##:::: ##: ##::::::::'##:. ##:: ##:::..:: ##:::::::
//: ##:: ## ## ##:::: ##:::: ######::: ########:: ######:::'##:::. ##: ##::::::: ######:::
//: ##:: ##. ####:::: ##:::: ##...:::: ##.. ##::: ##...:::: #########: ##::::::: ##...::::
//: ##:: ##:. ###:::: ##:::: ##::::::: ##::. ##:: ##::::::: ##.... ##: ##::: ##: ##:::::::
//'####: ##::. ##:::: ##:::: ########: ##:::. ##: ##::::::: ##:::: ##:. ######:: ########:
//....::..::::..:::::..:::::........::..:::::..::..::::::::..:::::..:::......:::........::
//
#define error OrderAlreadyExists()
#define error OrderNotFound()
#define error NotOrderOwner()
#define error NotAuthorizedExecutor()
#define error ZeroAmount()
#define error BelowMinimumOrder()
#define error PriorityFeeTooLarge()
#define error PriorityFeeTooSmall()
#define error PriorityFeeNotEscrowed()
#define error InvalidOrderingModeChange()

//:'######::'########::'#######::'########:::::'###:::::'######:::'########:
//'##... ##:... ##..::'##.... ##: ##.... ##:::'## ##:::'##... ##:: ##.....::
// ##:::..::::: ##:::: ##:::: ##: ##:::: ##::'##:. ##:: ##:::..::: ##:::::::
//. ######::::: ##:::: ##:::: ##: ########::'##:::. ##: ##::'####: ######:::
//:..... ##:::: ##:::: ##:::: ##: ##.. ##::: #########: ##::: ##:: ##...::::
//'##::: ##:::: ##:::: ##:::: ##: ##::. ##:: ##.... ##: ##::: ##:: ##:::::::
//. ######::::: ##::::. #######:: ##:::. ##: ##:::: ##:. ######::: ########:
//:......::::::..::::::.......:::..:::::..::..:::::..:::......::::........::
//
#define constant MODE_FIFO = 0x00
#define constant MODE_PRIORITY_FEE = 0x01
#define constant MIN_PRIORITY_FEE = 0x0186a0   // 100_000: $0.10 in six-decimal USDC

// Book locals. Callers set B_P and B_ID (and B_O through ORDER_TO_B) before a routine below.
#define constant B_P     = 0x600
#define constant B_ID    = 0x620
#define constant B_O     = 0x640
#define constant B_L     = 0x660
#define constant B_BUY   = 0x680
#define constant B_PRICE = 0x6a0
#define constant B_COUNT = 0x6c0
#define constant B_OWNER = 0x6e0
#define constant B_IN    = 0x700
#define constant B_MIN   = 0x720
#define constant B_ZFO   = 0x740
#define constant B_FEE   = 0x760

// Slots
//'########::'##::::'##:'########::'##:::::::'####::'######::
// ##.... ##: ##:::: ##: ##.... ##: ##:::::::. ##::'##... ##:
// ##:::: ##: ##:::: ##: ##:::: ##: ##:::::::: ##:: ##:::..::
// ########:: ##:::: ##: ########:: ##:::::::: ##:: ##:::::::
// ##.....::: ##:::: ##: ##.... ##: ##:::::::: ##:: ##:::::::
// ##:::::::: ##:::: ##: ##:::: ##: ##:::::::: ##:: ##::: ##:
// ##::::::::. #######:: ########:: ########:'####:. ######::
//..::::::::::.......:::........:::........::....:::......:::
/// @dev The order record of `id` in pool `P`.
#define macro ORDER_SLOT() = takes (2) returns (1) {
    // [P, id]
    0x03 add swap1 HASH_2()
}

/// @dev The level of `price` on side `isBuy`: seed `P + 5` for bids, `P + 6` for asks.
#define macro LEVEL_SLOT() = takes (3) returns (1) {
    // [P, isBuy, price]
    0x06 add sub swap1 HASH_2()
}

/// @dev The price tree of side `isBuy`: `P + 1` for bids, `P + 2` for asks.
#define macro SIDE_TREE() = takes (2) returns (1) {
    // [P, isBuy]
    0x02 add sub
}

/// @dev The `isExecutor[maker][executor]` slot of pool `P`.
#define macro EXECUTOR_SLOT() = takes (3) returns (1) {
    // [P, maker, executor]
    0x04 add swap1 HASH_2()
    swap1 HASH_2()
}

#define macro ORDERING_MODE() = takes (1) returns (1) {
    // [P]
    pop 0x01
}

// Record fields
#define macro O_OWNER() = takes (1) returns (1) { [ADDRESS_MASK] and }
#define macro O_BUY() = takes (1) returns (1) { 0xa0 shr 0xff and }
#define macro O_ZFO() = takes (1) returns (1) { 0xa8 shr 0xff and }
#define macro O_ESCROWED() = takes (1) returns (1) { 0xb0 shr 0xff and }
#define macro O_FEE() = takes (1) returns (1) { 0xb8 shr [UINT64_MASK] and }
#define macro O_PRICE() = takes (1) returns (1) { [UINT128_MASK] and }
#define macro O_PK() = takes (1) returns (1) { 0x80 shr }

/// @dev `paidPriorityFee(info)`: the escrowed bid, 0 when the bid was never paid.
#define macro O_PAID_FEE() = takes (1) returns (1) {
    // [w0]
    dup1 O_FEE() swap1 O_ESCROWED() mul
}

/// @dev The order slot of `id` in the loaded pool (B_P).
#define macro ORDER_OF() = takes (1) returns (1) {
    // [id]
    [B_P] mload ORDER_SLOT()
}

/// @dev `_priorityKey(fee, sequence) = (fee << 64) | (2^64 − 1 − sequence)`.
#define macro PRIORITY_KEY_OF() = takes (2) returns (1) {
    // [fee, sequence]
    0x40 shl swap1 [UINT64_MASK] sub or
}

/// @dev B_BUY, B_PRICE and the level slot B_L of the order at B_O.
#define macro LOAD_POSITION() = takes (0) returns (0) {
    [B_O] mload sload O_BUY() [B_BUY] mstore
    [B_O] mload 0x01 add sload O_PRICE() [B_PRICE] mstore
    [B_PRICE] mload [B_BUY] mload [B_P] mload LEVEL_SLOT() [B_L] mstore
}

/// @dev `book.openOrderCount += delta` (two's complement delta).
#define macro OPEN_ORDER_COUNT_ADD() = takes (1) returns (0) {
    // [delta]
    0x40 shl [B_P] mload sload add [B_P] mload sstore
}

// Level maintenance
/// @notice Enter B_O / B_ID into its price level by escrowed bid and queue sequence.
#define fn BOOK_APPEND() = takes (0) returns (0) {
    LOAD_POSITION()
    [B_L] mload 0x02 add sload dup1 [B_COUNT] mstore
    has_level jumpi
    [B_PRICE] mload [B_BUY] mload [B_P] mload SIDE_TREE() TREE_INSERT() pop
    has_level:
    [B_O] mload 0x04 add sload 0x40 shr [B_O] mload sload O_FEE() PRIORITY_KEY_OF()
    dup1 0x80 shl [B_PRICE] mload or [B_O] mload 0x01 add sstore
    dup1 [B_L] mload 0x03 add TREE_INSERT() pop
    [B_L] mload 0x04 add swap1 HASH_2() [B_ID] mload swap1 sstore
    REFRESH_EXACT()
    [B_COUNT] mload 0x01 add [B_L] mload 0x02 add sstore
    0x01 OPEN_ORDER_COUNT_ADD()
}
#define fn BOOK_REMOVE() = takes (0) returns (0) {
    LOAD_POSITION()
    [B_L] mload 0x03 add TREE_LOAD()
    [B_O] mload 0x01 add sload O_PK() LEAF_SLOT() sload
    NODE_SLOT() sload [UINT32_MASK] and NODE_SLOT() sload [UINT32_MASK] and 0x24c0 mstore
    [B_O] mload 0x01 add sload O_PK()
    dup1 [B_L] mload 0x03 add TREE_REMOVE()
    [B_L] mload 0x04 add swap1 HASH_2() 0x00 swap1 sstore
    0x00 0x24c0 mload REPAIR_EXACT()
    [B_L] mload 0x02 add dup1 sload 0x01 swap1 sub dup1 [B_COUNT] mstore swap1 sstore
    0x00 not OPEN_ORDER_COUNT_ADD()
    [B_COUNT] mload done jumpi
    [B_PRICE] mload [B_BUY] mload [B_P] mload SIDE_TREE() TREE_REMOVE()
    done:
}

/// @dev Logically delete the order at B_O; public views gate retained fields on amountIn.
#define macro DELETE_ORDER() = takes (0) returns (0) {
    // amountIn is the sole liveness marker; other words are overwritten on recreation.
    0x00 [B_O] mload 0x02 add sstore
}

/// @dev B_O = order slot of B_ID in B_P.
#define macro ORDER_TO_B() = takes (0) returns (0) {
    [B_ID] mload [B_P] mload ORDER_SLOT() [B_O] mstore
}

/// @dev `++book.nextSequence` (checked `uint64`).
#define macro NEXT_SEQUENCE() = takes (0) returns (1) {
    [B_P] mload sload                           // [hdr]
    dup1 [UINT64_MASK] and 0x01 add             // [seq, hdr]
    dup1 [UINT64_MASK] lt iszero fits jumpi
    PANIC(0x11)
    fits:
    swap1 0x01 add [B_P] mload sstore           // [seq]
}

// Transitions
/// @notice `AsyncFiller.addOrder`. Inputs: B_P, B_ID, B_OWNER, B_IN, B_MIN, B_BUY, B_ZFO, B_FEE.
#define fn MIN_BID() = takes (1) returns (1) {
    0x2710 swap1 0x0a MUL_DIV()
    [MIN_PRIORITY_FEE] dup2 gt iszero done jumpi
    pop [MIN_PRIORITY_FEE]
    done:
}
#define fn CHECK_MINIMUM() = takes (0) returns (0) {
    [B_P] mload 0x08 add sload dup1 0x2500 mstore iszero done jumpi
    [B_BUY] mload iszero sell jumpi
    0x2500 mload [B_IN] mload lt bad jumpi
    done jump
    sell:
    0x2500 mload [B_MIN] mload lt bad jumpi
    [E_PID] mload 0x00 mstore [POOLS_SLOT] 0x20 mstore 0x40 0x00 sha3 PM_EXTSLOAD()
    0xffffffffffffffffffffffffffffffffffffffff and 0x2520 mstore
    [B_ZFO] mload iszero reverse jumpi
    0x01000000000000000000000000 0x2520 mload [B_IN] mload MUL_DIV()
    0x01000000000000000000000000 0x2520 mload swap2 MUL_DIV() check jump
    reverse:
    0x2520 mload 0x01000000000000000000000000 [B_IN] mload MUL_DIV()
    0x2520 mload 0x01000000000000000000000000 swap2 MUL_DIV()
    check: 0x2500 mload gt bad jumpi
    done jump
    bad: __ERROR(BelowMinimumOrder) REVERT_0()
    done:
}
#define fn BOOK_ADD() = takes (0) returns (0) {
    CHECK_MINIMUM()
    [B_BUY] mload iszero sell jumpi
    [B_IN] mload notional jump
    sell: [B_MIN] mload
    notional: MIN_BID() [B_FEE] mload lt iszero fee_checked jumpi
    __ERROR(PriorityFeeTooSmall) REVERT_0()
    fee_checked:
    [UINT64_MASK] [B_FEE] mload gt iszero fee_fits jumpi
    __ERROR(PriorityFeeTooLarge) REVERT_0()
    fee_fits:
    [B_FEE] mload iszero escrowed jumpi
    [B_FEE] mload NUMERAIRE() address F_MINT()
    escrowed:
    [B_MIN] mload [B_IN] mload [B_ZFO] mload [B_BUY] mload BOOK_PRICE_KEY()
    NEXT_SEQUENCE()
    ORDER_TO_B()
    dup1 dup1 0x40 shl or [B_O] mload 0x04 add sstore
    0x00 PRIORITY_KEY_OF() 0x80 shl or [B_O] mload 0x01 add sstore
    [B_FEE] mload 0xb8 shl 0x01 0xb0 shl or
    [B_ZFO] mload 0xa8 shl or [B_BUY] mload 0xa0 shl or [B_OWNER] mload or [B_O] mload sstore
    [B_IN] mload [B_O] mload 0x02 add sstore
    [B_MIN] mload [B_O] mload 0x03 add sstore
    BOOK_APPEND()
}

/// @notice `AsyncFiller.setOrderingMode`: only while the pool has no open order.
#define macro BOOK_SET_MODE() = takes (2) returns (0) {
    // [P, mode]
    dup1 sload 0x40 shr [UINT64_MASK] and iszero empty jumpi
    __ERROR(InvalidOrderingModeChange) REVERT_0()
    empty:
    dup1 sload 0xff 0x80 shl not and            // [hdr without mode, P, mode]
    dup3 0x80 shl or swap1 sstore pop
}

// Queries
/// @notice Select the best exact price within the level, then its highest priority key.
#define fn BOOK_BEST_AT_PRICE() = takes (3) returns (1) {
    // [P, buy, price]
    dup2 [B_BUY] mstore
    dup1 [B_P] mstore LEVEL_SLOT() dup1 [B_L] mstore 0x03 add TREE_LOAD()
    [T_SLOT] mload sload [UINT32_MASK] and dup1 iszero done jumpi
    EXACT_BEST()
    done:
}

/// @notice `AsyncFiller.level(isBuy, price)` → (head, tail, orderCount).
#define macro BOOK_LEVEL_VIEW() = takes (3) returns (3) {
    // [P, isBuy, price]
    dup1 ORDERING_MODE() swap3 swap2 swap1 LEVEL_SLOT()   // [L, mode]
    dup1 0x02 add sload                         // [count, L, mode]
    swap2 priority jumpi                        // [L, count]
    dup1 0x01 add sload swap1 sload             // [head, tail, count]
    done jump
    priority:                                   // [L, count]
    0x00 dup2 0x03 add TREE_BEST()              // [hasTail, lowKey, L, count]
    iszero no_tail jumpi
    dup2 0x04 add swap1 HASH_2() sload          // [tail, L, count]
    tailed jump
    no_tail:
    pop 0x00
    tailed:                                     // [tail, L, count]
    swap1
    0x01 dup2 0x03 add TREE_BEST()              // [hasHead, highKey, L, tail, count]
    iszero no_head jumpi
    swap1 0x04 add swap1 HASH_2() sload         // [head, tail, count]
    done jump
    no_head:
    pop pop 0x00
    done:
}

/// @dev Creation sequence stays in the low 64 bits; queue sequence occupies the next 64.
#define macro SET_QUEUE_SEQUENCE() = takes (2) returns (0) {
    // [slot, sequence]
    dup1 sload [UINT64_MASK] and swap1 swap2 0x40 shl or swap1 sstore
}

/// @dev Canonical zero for a deleted order's retained field. [O, offset].
#define macro LIVE_ORDER_FIELD() = takes (2) returns (1) {
    dup1 0x02 add sload iszero absent jumpi
    add sload done jump
    absent: pop pop 0x00
    done:
}
