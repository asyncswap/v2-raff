/// @title FeeVault
/// @notice Holds protocol fees and forfeited bids as ERC-6909 claims in the PoolManager.
/// @dev Huff build of `asyncswap/v2-from-proofs` `src/FeeVault.sol`. Spec: `AsyncSwapProtocol/Model.lean`
///      `collectFees` / `collect_settlement`: owner-only; moves exactly the vault's claims in that currency to
///      the recipient; touches no order and no hook claim. Constructor: `(IPoolManager manager, address owner)`.

#include "./lib/Common.huff"
#include "./lib/PoolManager.huff"
#include "./lib/Owned2Step.huff"

#define error NotPoolManager()

#define event FeesCollected(address indexed, address indexed, uint256)

#define constant OWNER_SLOT = 0x00
#define constant PENDING_OWNER_SLOT = 0x01

#define constant IMMUTABLES = __codesize(RUNTIME)

#define macro MANAGER() = takes (0) returns (1) { 0x40 mload }

#define macro CONSTRUCTOR() = takes (0) returns (0) {
    0x40 dup1 codesize sub 0x00 codecopy        // (manager, owner) → 0x00, 0x20
    0x20 mload OWNED_INIT()
    [IMMUTABLES] __codesize(CONSTRUCTOR) 0x100 codecopy
    0x00 mload [IMMUTABLES] 0x100 add mstore
    [IMMUTABLES] 0x20 add 0x100 return
}

/// @notice `collect(currency, recipient)`: burn every claim of `currency` the vault holds and send the tokens.
#define macro COLLECT() = takes (0) returns (0) {
    ONLY_OWNER()
    LOAD_ADDRESS(0x24)
    dup1 has_recipient jumpi
    __ERROR(ZeroAddress) REVERT_0()
    has_recipient:
    [CALL_64] mstore
    LOAD_ADDRESS(0x04) [CALL_44] mstore
    0x40 PM_UNLOCK()
    0x60 returndatasize lt iszero decodable jumpi
    0x00 0x00 revert
    decodable:
    0x20 0x40 0x00 returndatacopy
    0x20 0x00 return
}

#define macro UNLOCK_CALLBACK() = takes (0) returns (0) {
    MANAGER() caller eq from_manager jumpi
    __ERROR(NotPoolManager) REVERT_0()
    from_manager:
    0x64 calldataload 0x44 calldataload         // [currency, recipient]
    dup1 address PM_BALANCE_OF()                // [amount, currency, recipient]
    dup1 iszero nothing jumpi
    dup1 dup3 address PM_BURN()
    dup1 dup4 dup4 PM_TAKE()
    nothing:
    dup1 [MEM_LOG] mstore
    swap2 swap1                                 // [currency, recipient, amount]
    __EVENT_HASH(FeesCollected) 0x20 [MEM_LOG] log3
    [MEM_LOG] mstore
    0x20 [MEM_LOG] RETURN_BYTES()
}

#define macro MAIN() = takes (0) returns (0) {
    0x20 [IMMUTABLES] 0x40 codecopy
    NON_PAYABLE()
    0x00 calldataload 0xe0 shr
    dup1 __FUNC_SIG("unlockCallback(bytes)") eq unlock_callback jumpi
    dup1 __FUNC_SIG("collect(address,address)") eq collect jumpi
    dup1 __FUNC_SIG("owner()") eq owner jumpi
    dup1 __FUNC_SIG("pendingOwner()") eq pending_owner jumpi
    dup1 __FUNC_SIG("transferOwnership(address)") eq transfer_ownership jumpi
    dup1 __FUNC_SIG("acceptOwnership()") eq accept_ownership jumpi
    dup1 __FUNC_SIG("manager()") eq manager jumpi
    0x00 0x00 revert

    unlock_callback:    UNLOCK_CALLBACK()
    collect:            COLLECT()
    owner:              [OWNER_SLOT] sload RETURN_1()
    pending_owner:      [PENDING_OWNER_SLOT] sload RETURN_1()
    transfer_ownership: TRANSFER_OWNERSHIP()
    accept_ownership:   ACCEPT_OWNERSHIP()
    manager:            MANAGER() RETURN_1()
}
