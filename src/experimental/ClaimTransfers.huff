// Test-only ABI adapter for run(address manager, uint256[3][] credits).
#include "../lib/Common.huff"
#include "../lib/PoolManager.huff"
#include "../current/lib/ClaimTransfers.huff"
#define macro MANAGER() = takes (0) returns (1) { 0x40 mload }
#define macro MAIN() = takes (0) returns (0) {
    0x04 calldataload 0x40 mstore
    0x01 [CB_ACTIVE] mstore [CB_START] [CB_END] mstore
    0x64
    loop:
    calldatasize dup2 eq done jumpi
    dup1 0x40 add calldataload dup2 0x20 add calldataload dup3 calldataload TRANSFER_CLAIMS()
    0x60 add loop jump
    done: pop
    0x60 [CB_START] [CB_END] mload sub div
    FLUSH_CLAIMS() RETURN_1()
}
