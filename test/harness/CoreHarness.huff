#include "../../src/lib/Common.huff"
#include "../../src/lib/PoolManager.huff"
#include "../../src/current/lib/WrappedRevert.huff"
#include "../../src/current/lib/CurrencyTransfer.huff"
#define macro MANAGER() = takes (0) returns (1) { 0x04 calldataload }
#define macro MAIN() = takes (0) returns (0) {
    calldatasize iszero received jumpi
    0x00 calldataload 0xe0 shr
    dup1 __FUNC_SIG("transfer(address,address,uint256)") eq transfer jumpi
    dup1 __FUNC_SIG("poolStateSlot(bytes32)") eq slot jumpi
    dup1 __FUNC_SIG("getSlot0(address,bytes32)") eq slot0 jumpi
    dup1 __FUNC_SIG("getLiquidity(address,bytes32)") eq liquidity jumpi
    0x00 0x00 revert
    transfer: 0x44 calldataload 0x24 calldataload 0x04 calldataload TRANSFER_CURRENCY() RETURN_EMPTY()
    slot: [POOLS_SLOT] 0x04 calldataload HASH_2() RETURN_1()
    liquidity: 0x24 calldataload PM_LIQUIDITY() RETURN_1()
    slot0:
        [POOLS_SLOT] 0x24 calldataload HASH_2() PM_EXTSLOAD()
        dup1 [ADDRESS_MASK] and 0x00 mstore
        dup1 0xa0 shr 0x02 signextend 0x20 mstore
        dup1 0xb8 shr 0xffffff and 0x40 mstore
        0xd0 shr 0xffffff and 0x60 mstore 0x80 0x00 return
    received: RETURN_EMPTY()
}
