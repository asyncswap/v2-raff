// Thin ABI adapter; arithmetic is the same production Huff helper.
#include "../../src/lib/Common.huff"
#include "../../src/lib/Math.huff"
#define macro MAIN() = takes (0) returns (0) {
    0x44 calldataload 0x24 calldataload 0x04 calldataload
    0x00 calldataload 0xe0 shr __FUNC_SIG("ceil(uint256,uint256,uint256)") eq ceiling jumpi
    MUL_DIV() RETURN_1()
    ceiling: MUL_DIV_UP() RETURN_1()
}
