// Constructor-provided manager/quote/vault and direct order setters mirror the upstream library fixture.
#include "../../src/lib/Common.huff"
#include "../../src/lib/PoolManager.huff"
#include "../../src/current/lib/OrderFields.huff"
#include "../../src/current/lib/ClaimTransfers.huff"
#include "../../src/current/lib/PriorityFees.huff"
#define constant E_PID = 0x140
#define event PriorityFeeForfeited(bytes32 indexed, bytes32 indexed, address indexed, uint256)
#define macro MANAGER() = takes (0) returns (1) { 0x00 sload }
#define macro NUMERAIRE() = takes (0) returns (1) { 0x01 sload }
#define macro FEE_VAULT() = takes (0) returns (1) { 0x02 sload }
#define macro MAIN() = takes (0) returns (0) {
    0x00 calldataload 0xe0 shr
    dup1 __FUNC_SIG("setOrder(bytes32,address,uint256,uint64,bool)") eq seed jumpi
    dup1 __FUNC_SIG("settleOrderPriorityFee((address,address,uint24,int24,address),bytes32)") eq settle jumpi
    0x00 0x00 revert
    seed:
    0x03 0x04 calldataload HASH_2()
    0x24 calldataload 0x64 calldataload 0xb8 shl or 0x01 0xb0 shl or dup2 sstore
    0x44 calldataload swap1 0x02 add sstore RETURN_EMPTY()
    settle:
    0xa0 0x04 [E_KEY] calldatacopy 0xa0 [E_KEY] sha3 [E_PID] mstore
    0x03 0xa4 calldataload HASH_2() sload dup1 O_PAID_FEE() swap1 O_OWNER()
    0xa4 calldataload SETTLE_PRIORITY_FEE() RETURN_EMPTY()
}
