/// @notice Exposes the Huff `RadixPriceTree` for `test/RadixPriceTree.t.sol`.
#include "../../src/lib/Common.huff"
#include "../../src/lib/Math.huff"
#include "../../src/lib/RadixPriceTree.huff"

#define function insert(uint128) nonpayable returns (bool)
#define function remove(uint128) nonpayable returns ()
#define function best(bool) view returns (bool, uint128)
#define function contains(uint128) view returns (bool)
#define function root() view returns (uint32)
#define function nextNodeId() view returns (uint32)
#define function freeCount() view returns (uint256)
#define function node(uint32) view returns (uint32,uint32,uint32,uint128,uint8,bool)
#define function leafOf(uint128) view returns (uint32)
#define function msb(uint128) pure returns (uint8)

#define constant TREE = 0x01

#define macro MAIN() = takes (0) returns (0) {
    0x00 calldataload 0xe0 shr
    dup1 __FUNC_SIG(insert) eq insert jumpi
    dup1 __FUNC_SIG(remove) eq remove jumpi
    dup1 __FUNC_SIG(best) eq best jumpi
    dup1 __FUNC_SIG(contains) eq contains jumpi
    dup1 __FUNC_SIG(root) eq root jumpi
    dup1 __FUNC_SIG(nextNodeId) eq next_node_id jumpi
    dup1 __FUNC_SIG(freeCount) eq free_count jumpi
    dup1 __FUNC_SIG(node) eq node jumpi
    dup1 __FUNC_SIG(leafOf) eq leaf_of jumpi
    dup1 __FUNC_SIG(msb) eq msb jumpi
    0x00 0x00 revert

    insert:
        0x04 calldataload [TREE] TREE_INSERT() RETURN_1()
    remove:
        0x04 calldataload [TREE] TREE_REMOVE() RETURN_EMPTY()
    best:
        0x04 calldataload [TREE] TREE_BEST() RETURN_2()
    contains:
        0x04 calldataload [TREE] TREE_CONTAINS() RETURN_1()
    root:
        [TREE] sload [UINT32_MASK] and RETURN_1()
    next_node_id:
        [TREE] sload 0x20 shr [UINT32_MASK] and RETURN_1()
    free_count:
        [TREE] sload 0x40 shr [UINT32_MASK] and RETURN_1()
    node:
        [TREE] TREE_LOAD()
        0x04 calldataload NODE_SLOT() sload          // [n]
        dup1 [UINT32_MASK] and 0x00 mstore
        dup1 LEFT() 0x20 mstore
        dup1 RIGHT() 0x40 mstore
        dup1 NODE_PRICE() 0x60 mstore
        dup1 NODE_BIT() 0x80 mstore
        IS_LEAF() 0xa0 mstore
        0xc0 0x00 return
    leaf_of:
        [TREE] TREE_LOAD()
        0x04 calldataload LEAF_SLOT() sload RETURN_1()
    msb:
        0x04 calldataload MSB() RETURN_1()
}
