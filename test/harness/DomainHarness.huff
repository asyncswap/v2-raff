#include "../../src/lib/Common.huff"
#include "../../src/lib/Signatures.huff"
#include "../../src/current/lib/Domain.huff"
#define macro MAIN() = takes (0) returns (0) {
    0x00 calldataload 0xe0 shr
    dup1 __FUNC_SIG("DOMAIN_SEPARATOR()") eq separator jumpi
    dup1 __FUNC_SIG("domainSeparatorV4()") eq separator jumpi
    dup1 __FUNC_SIG("eip712Domain()") eq domain jumpi
    dup1 __FUNC_SIG("eip712Name()") eq name jumpi
    dup1 __FUNC_SIG("eip712Version()") eq version jumpi
    0x00 0x00 revert
    separator: DOMAIN_SEPARATOR() RETURN_1()
    domain: EIP712_DOMAIN()
    // Return the actual fields encoded by the production endpoint as one ABI string.
    name: ENCODE_EIP712_DOMAIN() 0x20 0xc0 mstore 0x60 0xc0 return
    version: ENCODE_EIP712_DOMAIN() 0x20 0x100 mstore 0x60 0x100 return
}
