pragma solidity ^0.8.26;
// Generated by uv4/examples/export_priority_vectors.py. The UpdatePrice and CancelOrder vectors were recomputed with
// `cast` from their EIP-712 type strings after L-01 changed both types; the uv4 exporter still emits the old ones.
import {Test} from "forge-std/Test.sol";
import {OrderSignatures} from "@async-swap/libraries/OrderSignatures.sol";
import {AsyncOrder} from "@async-swap/types/AsyncOrder.sol";
import {PoolKey} from "v4-core/types/PoolKey.sol";
import {Currency} from "v4-core/types/Currency.sol";
import {IHooks} from "v4-core/interfaces/IHooks.sol";

contract PriorityPythonHashesTest is Test {
    function test_pythonHashesMatchSolidityLibrary() public pure {
        PoolKey memory k = PoolKey(
            Currency.wrap(address(uint160(6880565558451215531888159581837376232848337053))),
            Currency.wrap(address(uint160(109215513821915005001999021604733646731899842218))),
            8388608,
            60,
            IHooks(address(uint160(1411823305748668547179593314318821410444331089065)))
        );
        address maker = address(uint160(832226269130282241723926830984263339865046684876));
        AsyncOrder memory o = AsyncOrder(
            k,
            maker,
            true,
            1000000000000000000,
            1000000000,
            100000,
            0,
            0x1212121212121212121212121212121212121212121212121212121212121212
        );
        bytes32 id = keccak256(abi.encode(uint256(1), keccak256(abi.encode(k)), maker, o.zeroForOne, o.salt));
        assertEq(keccak256(abi.encode(k)), 0x08c778cd9f29134fa4ef99725d676101eed22678c0aa6349a301c176ce0ab6d1);
        assertEq(id, 0xbffae60aaa65b400b002085db74992a2f67479475af929e58dcf03b385dd0833);
        assertEq(OrderSignatures.hashPoolKey(k), 0x8db8749a4ac6fe88bc26f787642781dd828eb2d238c680c436b244f8aead370d);
        assertEq(OrderSignatures.hashOrder(o), 0x5d291107c1425776ccd9747c37affbfdb668e473dac84c0daeb18e48970ce406);
        assertEq(
            OrderSignatures.hashSetExecutor(
                k, maker, address(uint160(64513016164418060487339768416962623177173565829)), true, 7, 100
            ),
            0x83cb48b27bae0fca22b3074f06d1518a4430f4097c3311b605705362a1a3007a
        );
        assertEq(
            OrderSignatures.hashUpdatePrice(o, id, o.amountIn, 2000000000, 1, 0, 8, 100),
            0x0a3b961e93197f1a292e87e3503868a93c9d29584ed77d5ac4b46f5179563d82
        );
        assertEq(
            OrderSignatures.hashCancel(o, id, 1, 9, 100),
            0x2314d64356b0642efd7e5f61993cdf72b64a4b6697d1902f41edcd846e2bdd49
        );
    }
}
